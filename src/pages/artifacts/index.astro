  <head>
    <meta http-equiv="refresh" content="0;url=/bookmarks" />
    <link rel="canonical" href="/bookmarks" />
    <title>Redirecting to Bookmarks...</title>
    <script is:inline>
      window.location.href = "/bookmarks";
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/bookmarks">/bookmarks</a>...</p>
  </body>
</html>
