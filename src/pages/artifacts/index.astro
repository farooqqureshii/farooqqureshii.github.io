---
import { SITE_DESCRIPTION } from "../../consts";
import type { Artifact, ArtifactCategory } from "../../data/artifacts";
import { artifacts as baseArtifacts } from "../../data/artifacts";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

function withCategories(
  a: Artifact,
): Artifact & { categories: ArtifactCategory[] } {
  const cats = a.categories?.length
    ? a.categories
    : a.type === "image"
      ? (["photography"] as ArtifactCategory[])
      : a.type === "video"
        ? (["tools"] as ArtifactCategory[])
        : (["design"] as ArtifactCategory[]);
  return { ...a, categories: cats };
}

const artifacts = baseArtifacts.map(withCategories);

const items = artifacts.filter((a) => {
  if (a.type === "link") return !!a.url;
  if (a.type === "video") return !!a.url;
  if (a.type === "image") return !!a.image;
  return false;
});

const byType: {
  link: typeof items;
  image: typeof items;
  video: typeof items;
} = {
  link: items.filter((i) => i.type === "link"),
  image: items.filter((i) => i.type === "image"),
  video: items.filter((i) => i.type === "video"),
};

// Interleave types so links don't clump in one column.
const itemsMixed: typeof items = [];
while (byType.image.length || byType.link.length || byType.video.length) {
  if (byType.image.length) itemsMixed.push(byType.image.shift()!);
  if (byType.link.length) itemsMixed.push(byType.link.shift()!);
  if (byType.video.length) itemsMixed.push(byType.video.shift()!);
}
---

<Layout
  title="Farooq Q. | Artifacts"
  description={SITE_DESCRIPTION}
>
  <div class="no-link-underline">
    <nav class="filter-nav mb-8 flex items-center gap-1.5 text-sm" aria-label="Filter artifacts">
      <button type="button" class="filter-link" data-tab="all">All</button>
      <span class="filter-sep">/</span>
      <button type="button" class="filter-link" data-tab="link">Links</button>
      <span class="filter-sep">/</span>
      <button type="button" class="filter-link" data-tab="image">Images</button>
      <span class="filter-sep">/</span>
      <button type="button" class="filter-link" data-tab="video">Videos</button>
    </nav>

    <div class="artifact-grid space-y-4">
      {
        itemsMixed.map((item) => (
          <a
            href={item.type === "image" ? item.image : item.url}
            target="_blank"
            rel="noopener"
            class="artifact-card no-underline group block overflow-hidden rounded-md border border-zinc-200 bg-zinc-50/50 p-3 text-sm dark:border-zinc-800 dark:bg-zinc-900/40"
            data-type={item.type}
          >
            {item.type === "image" ? (
              <div>
                <img
                  src={item.image}
                  alt={item.alt || item.title || "Artifact image"}
                  class="mb-2 block h-auto w-full rounded border border-zinc-200/60 object-cover dark:border-zinc-800/60"
                  loading="lazy"
                  decoding="async"
                />
                {item.title && (
                  <p class="text-xs text-zinc-600 dark:text-zinc-400">
                    {item.title}
                  </p>
                )}
              </div>
            ) : (
              <div>
                <div class="flex items-baseline justify-between gap-2">
                  <p class="font-medium text-zinc-900 dark:text-zinc-100 no-underline">
                    {item.title?.trim() || item.domain || (item.url ?? "")}
                  </p>
                  {item.type === "video" && (
                    <span class="shrink-0 text-xs text-zinc-400 dark:text-zinc-500">
                      ▶
                    </span>
                  )}
                </div>
                {(item.description || item.domain) && (
                  <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
                    {item.description?.trim() || item.domain}
                  </p>
                )}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </div>

  <style>
    .filter-nav {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 2rem;
    }
    .filter-link {
      font-size: 0.875rem;
      color: #71717a;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: color 150ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    html.dark .filter-link {
      color: #a1a1aa;
    }
    @media (hover: hover) and (pointer: fine) {
      .filter-link:hover {
        color: #111111;
      }
      html.dark .filter-link:hover {
        color: #ffffff;
      }
    }
    .filter-link.is-active {
      color: #111111 !important;
      font-weight: 500;
    }
    html.dark .filter-link.is-active {
      color: #ffffff !important;
    }
    .filter-sep {
      font-size: 0.875rem;
      color: #e4e4e7;
      user-select: none;
    }
    html.dark .filter-sep {
      color: #3f3f46;
    }
  </style>

  <script>
    function initArtifacts() {
      const tabs = Array.from(document.querySelectorAll(".filter-link"));
      const cards = Array.from(document.querySelectorAll(".artifact-card"));

      if (!tabs.length || !cards.length) return;

      const setActive = (name: string) => {
        tabs.forEach((t) => {
          const isAct = (t as HTMLElement).dataset.tab === name;
          t.classList.toggle("is-active", isAct);
        });
        cards.forEach((c) => {
          const type = (c as HTMLElement).dataset.type;
          const show = name === "all" || type === name;
          (c as HTMLElement).style.display = show ? "block" : "none";
        });
      };

      tabs.forEach((t) => {
        t.addEventListener("click", () => {
          const tabName = (t as HTMLElement).dataset.tab;
          if (tabName) setActive(tabName);
        });
      });

      setActive("all");
    }

    document.addEventListener("astro:page-load", initArtifacts);
    initArtifacts();
  </script>
</Layout>
