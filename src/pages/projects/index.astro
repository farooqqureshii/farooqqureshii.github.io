---
import { SITE_DESCRIPTION } from "../../consts";
import Layout from "../../layouts/Layout.astro";

interface ProjectLink {
  label: string;
  url: string;
  isInternal?: boolean;
}

interface Project {
  title: string;
  description: string;
  links: ProjectLink[];
}

const projects: Project[] = [
  {
    title: "PID Position Controller for Antenna Servo",
    description:
      "Position controller tuning and disturbance rejection in MATLAB and Simulink",
    links: [
      { label: "Report", url: "/reports/antenna-positioner-pid-report.pdf" },
      { label: "Code", url: "https://github.com/farooqqureshii/pid-antenna-positioner" },
    ],
  },
  {
    title: "Digital Filter Design for Interference Rejection",
    description:
      "Filter design for interference rejection using Python and SciPy",
    links: [
      { label: "Report", url: "/reports/dsp-filter-design-report.pdf" },
      { label: "Code", url: "https://github.com/farooqqureshii/dsp-filter" },
    ],
  },
  {
    title: "uOttaHack",
    description: "Director leading the team behind Ottawa's largest tech event",
    links: [
      { label: "Website", url: "https://www.uottahack.ca/" },
      { label: "Recap", url: "https://www.youtube.com/watch?v=RCi04EDupSw" },
    ],
  },
  {
    title: "uoee.rocks",
    description: "Course visualizer and search for uOttawa EE students",
    links: [
      { label: "Website", url: "https://uoee-rocks.vercel.app/" },
      { label: "Code", url: "https://github.com/farooqqureshii/uoee.rocks" },
    ],
  },
  {
    title: "What's Up with Serifs on Screens?",
    description:
      "Physics, mathematics, and rasterization engines of digital type",
    links: [
      { label: "Essay", url: "/projects/why-serifs-look-like-that-on-screens", isInternal: true },
    ],
  },
];
---

<Layout title="Farooq Q. | Projects" description={SITE_DESCRIPTION}>
  <div class="space-y-6 text-[var(--text-color)]">
    {
      projects.map((project) => (
        <div class="project-item space-y-0.5 text-[15px] leading-[1.65]">
          <div class="project-title text-[var(--text-color)]">
            {project.title}
          </div>
          <div class="project-desc text-[var(--text-color)]">
            {project.description}
          </div>
          <div class="project-links text-[var(--text-color)]">
            Links:{" "}
            {project.links.map((item, idx) => (
              <>
                {idx > 0 && ", "}
                <a
                  href={item.url}
                  target={item.isInternal ? undefined : "_blank"}
                  rel={item.isInternal ? undefined : "noopener"}
                  class="project-link"
                >
                  {item.label}
                </a>
              </>
            ))}
          </div>
        </div>
      ))
    }

    <p class="pt-2 text-[15px] leading-[1.65] text-[var(--text-color)]">
      More on <a href="https://github.com/farooqqureshii?tab=repositories" target="_blank" rel="noopener" class="project-link">GitHub</a>.
    </p>
  </div>
</Layout>
