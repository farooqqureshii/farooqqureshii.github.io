---
import { SITE_DESCRIPTION } from "../../consts";
import Layout from "../../layouts/Layout.astro";

const projects = [
  {
    title: "PID Position Controller for Antenna Servo",
    description:
      "Position controller tuning and disturbance rejection in MATLAB and Simulink",
    category: "engineering",
    github: "https://github.com/farooqqureshii/pid-antenna-positioner",
    report: "/reports/antenna-positioner-pid-report.pdf",
    technologies: ["MATLAB", "Simulink", "Control Systems", "PID Tuning", "Bode Analysis"],
  },
  {
    title: "Digital Filter Design for Interference Rejection",
    description:
      "Filter design for interference rejection using Python and SciPy",
    category: "engineering",
    github: "https://github.com/farooqqureshii/dsp-filter",
    report: "/reports/dsp-filter-design-report.pdf",
    technologies: ["DSP", "FIR / IIR Filters", "Python", "SciPy", "Signal Processing"],
  },
  {
    title: "uOttaHack | Director",
    description: "Leading the team behind Ottawa's largest tech event",
    category: "product",
    link: "https://www.uottahack.ca/",
    technologies: ["PM", "UI/UX", "Figma", "Software", "Sales"],
  },
  {
    title: "Substack Case Study",
    description: "Product/strategy case study for Substack growth",
    category: "product",
    link: "/writing/substack/",
    technologies: ["PM", "Strategy", "UI/UX", "Marketing"],
  },
  {
    title: "uoee.rocks",
    description: "Course visualizer and search, for uOttawa EE students",
    category: "software",
    link: "https://uoee.rocks/",
    github: "https://github.com/farooqqureshii/uoee.rocks",
    technologies: ["React", "TypeScript", "Tailwind", "Framer Motion"],
  },
  {
    title: "okbutpitchit",
    description: "Code to Pitch-Ready slides, in an Instant",
    category: "software",
    link: "https://okbutpitchit.vercel.app/",
    github: "https://github.com/farooqqureshii/okbutpitchit",
    technologies: ["Next.js", "React", "Tailwind", "Node", "Llama 3"],
  },
  {
    title: "Voltus",
    description: "RLC circuit visualization, analysis, and simulation",
    category: "software",
    link: "https://voltus.streamlit.app/",
    github: "https://github.com/farooqqureshii/voltus",
    technologies: ["Streamlit", "Plotly", "NumPy", "SciPy", "Pandas"],
  },
  {
    title: "Code Compass",
    description:
      "Understand any GitHub repo and find beginner-friendly issues, fast",
    category: "software",
    link: "https://trycodecompass.vercel.app/",
    github: "https://github.com/farooqqureshii/code-compass",
    technologies: [
      "Next.js",
      "TypeScript",
      "Tailwind",
      "Groq Llama 3",
      "GitHub REST API",
    ],
  },
  {
    title: "EchoScope",
    description:
      "Use AI to uncover sentiment, bias, and diversity in YouTube comments",
    category: "software",
    link: "https://echoscope.vercel.app/",
    github: "https://github.com/farooqqureshii/echoscope",
    technologies: ["TypeScript", "Node", "TensorFlow", "Sentiment Analysis"],
  },
  {
    title: "Analyzing and predicting housing prices in London",
    description: "Smarter housing price predictions with machine learning",
    category: "software",
    link: "https://farooq.craft.me/write-up",
    technologies: ["Pandas", "Matplotlib", "Scikit-learn", "SHAP", "LightGBM"],
  },
  {
    title: "NLP for Google Calendar",
    description: "Conversational AI for Google Calendar using NLP",
    category: "software",
    link: "/static/nlp_vid.webm",
    technologies: ["LangChain", "Rasa", "Typescript", "OAuth"],
  },
  {
    title: "Notion2Todoist",
    description: "Syncing Tasks from Notion to Todoist",
    category: "software",
    link: "/static/notion api video.webm",
    technologies: ["REST API", "Bash", "Scripting", "Python"],
  },
  {
    title: "What's Up with Serifs on Screens?",
    description:
      "Physics, mathematics, and rasterization engines of digital type",
    category: "design",
    link: "/projects/why-serifs-look-like-that-on-screens",
    technologies: ["Design Engineering", "Typography", "Interactive Essay"],
  },
];

const categories = [
  { label: "Engineering", value: "engineering" },
  { label: "Design", value: "design" },
  { label: "Software", value: "software" },
  { label: "Product", value: "product" },
];
---

<Layout title="Farooq Q. | Projects" description={SITE_DESCRIPTION}>
  <div class="no-link-underline">
    <nav class="filter-nav mb-8 flex items-center gap-2 text-[15px]" aria-label="Filter projects">
      {
        categories.map((category, i) => (
          <>
            {i > 0 && <span class="filter-sep">/</span>}
            <button type="button" class="filter-link" data-tab={category.value}>
              {category.label}
            </button>
          </>
        ))
      }
    </nav>

    <div class="space-y-6">
      {
        projects.map((project) => (
          <div
            class="project-item space-y-1"
            data-type={project.category}
          >
            <div class="space-y-1 text-[15px] leading-[1.65]">
              <h2 class="project-title font-medium text-[15px]">
                {project.title}
              </h2>
              {project.description && (
                <p class="leading-relaxed opacity-60">
                  {project.description}
                </p>
              )}
              {(project.github || project.link || project.report) && (
                <div class="project-links flex flex-row flex-wrap gap-x-4 gap-y-0 pt-1 text-[15px]">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener"
                      class="project-link"
                    >
                      GitHub
                    </a>
                  )}

                  {project.link && (
                    <a
                      href={project.link}
                      target={project.link.startsWith("/") && !project.link.startsWith("/static/") ? undefined : "_blank"}
                      rel={project.link.startsWith("/") && !project.link.startsWith("/static/") ? undefined : "noopener"}
                      class="project-link"
                    >
                      Link
                    </a>
                  )}

                  {project.report && (
                    <a
                      href={project.report}
                      target="_blank"
                      rel="noopener"
                      class="project-link"
                    >
                      Report
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    .filter-nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .filter-link {
      font-size: 0.875rem;
      color: inherit;
      opacity: 0.6;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: opacity 150ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    @media (hover: hover) and (pointer: fine) {
      .filter-link:hover {
        opacity: 1;
      }
    }
    .filter-link.is-active {
      opacity: 1 !important;
      font-weight: 500;
    }
    .filter-sep {
      font-size: 0.875rem;
      color: inherit;
      opacity: 0.3;
      user-select: none;
    }
    .project-link {
      color: inherit !important;
      opacity: 0.6;
      text-decoration: none !important;
      transition: opacity 120ms cubic-bezier(0.23, 1, 0.32, 1), color 120ms cubic-bezier(0.23, 1, 0.32, 1) !important;
    }
    @media (hover: hover) and (pointer: fine) {
      .project-link:hover {
        opacity: 1 !important;
        color: var(--link-hover-color) !important;
        text-decoration: none !important;
      }
    }
  </style>

  <script>
    function initProjects() {
      const tabs = Array.from(document.querySelectorAll(".filter-link"));
      const cards = Array.from(document.querySelectorAll(".project-item"));

      if (!tabs.length || !cards.length) return;

      const setActive = (name: string) => {
        tabs.forEach((tab) => {
          const isAct = (tab as HTMLElement).dataset.tab === name;
          tab.classList.toggle("is-active", isAct);
        });

        cards.forEach((card) => {
          const show = name === "all" || (card as HTMLElement).dataset.type === name;
          (card as HTMLElement).style.display = show ? "block" : "none";
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const tabName = (tab as HTMLElement).dataset.tab;
          if (tabName) setActive(tabName);
        });
      });

      const urlParams = new URLSearchParams(window.location.search);
      const initialTab = urlParams.get("tab") || "engineering";
      setActive(initialTab);
    }

    document.addEventListener("astro:page-load", initProjects);
    initProjects();
  </script>
</Layout>
