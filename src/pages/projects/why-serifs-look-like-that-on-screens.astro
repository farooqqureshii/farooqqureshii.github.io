      transform: scale(1.2);
    }
    .custom-slider::-webkit-slider-thumb:active {
      transform: scale(0.92);
    }

    .glyph-field {
      width: 22px;
      text-align: center;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 4px;
      font-size: 0.75rem;
      padding: 1px 0;
      color: #111111;
      outline: none;
    }
    html.dark .glyph-field {
      background: #141417;
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #ffffff;
    }
  </style>

  <script>
    function initScreenTypoLab() {
      const dpr = window.devicePixelRatio || 1;

      // -------------------------------------------------------------
      // 1. BEZIER INTERACTIVE CANVAS
      // -------------------------------------------------------------
      const bCanvas = document.getElementById("bezier-canvas") as HTMLCanvasElement | null;
      const bHud = document.getElementById("bezier-hud");
      if (bCanvas) {
        const ctx = bCanvas.getContext("2d");
        let p0 = { x: 60, y: 170 };
        let p1 = { x: 130, y: 170 };
        let p2 = { x: 180, y: 90 };
        let p3 = { x: 180, y: 35 };
        let draggingPt: any = null;

        const resizeB = () => {
          const rect = bCanvas.getBoundingClientRect();
          bCanvas.width = rect.width * dpr;
          bCanvas.height = rect.height * dpr;
          const sx = rect.width / 420;
          const sy = rect.height / 220;
          p0 = { x: 60 * sx, y: 170 * sy };
          p1 = { x: 130 * sx, y: 170 * sy };
          p2 = { x: 180 * sx, y: 90 * sy };
          p3 = { x: 180 * sx, y: 35 * sy };
          drawB();
        };

        const drawB = () => {
          if (!ctx) return;
          const w = bCanvas.width;
          const h = bCanvas.height;
          ctx.clearRect(0, 0, w, h);

          const dark = document.documentElement.classList.contains("dark");

          ctx.strokeStyle = dark ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 0, 0, 0.05)";
          ctx.lineWidth = 1;
          const step = 20 * dpr;
          for (let x = 0; x < w; x += step) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, h);
            ctx.stroke();
          }
          for (let y = 0; y < h; y += step) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(w, y);
            ctx.stroke();
          }

          ctx.strokeStyle = "rgba(59, 130, 246, 0.4)";
          ctx.lineWidth = 1.5 * dpr;
          ctx.beginPath();
          ctx.moveTo(p0.x * dpr, p0.y * dpr);
          ctx.lineTo(p1.x * dpr, p1.y * dpr);
          ctx.moveTo(p2.x * dpr, p2.y * dpr);
          ctx.lineTo(p3.x * dpr, p3.y * dpr);
          ctx.stroke();

          ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
          ctx.beginPath();
          ctx.moveTo(p0.x * dpr, p0.y * dpr);
          ctx.bezierCurveTo(p1.x * dpr, p1.y * dpr, p2.x * dpr, p2.y * dpr, p3.x * dpr, p3.y * dpr);
          ctx.lineTo((p3.x + 45) * dpr, p3.y * dpr);
          ctx.lineTo((p3.x + 45) * dpr, (p0.y + 12) * dpr);
          ctx.lineTo(p0.x * dpr, (p0.y + 12) * dpr);
          ctx.closePath();
          ctx.fill();

          ctx.strokeStyle = "#0284c7";
          ctx.lineWidth = 2.5 * dpr;
          ctx.beginPath();
          ctx.moveTo(p0.x * dpr, p0.y * dpr);
          ctx.bezierCurveTo(p1.x * dpr, p1.y * dpr, p2.x * dpr, p2.y * dpr, p3.x * dpr, p3.y * dpr);
          ctx.stroke();

          [p0, p1, p2, p3].forEach((p, i) => {
            ctx.fillStyle = (i === 0 || i === 3) ? "#0284c7" : "#38bdf8";
            ctx.beginPath();
            ctx.arc(p.x * dpr, p.y * dpr, 4.5 * dpr, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 1.5 * dpr;
            ctx.stroke();
          });
        };

        const getPos = (e: MouseEvent) => {
          const rect = bCanvas.getBoundingClientRect();
          return { x: e.clientX - rect.left, y: e.clientY - rect.top };
        };

        bCanvas.addEventListener("mousedown", (e) => {
          const pos = getPos(e);
          const thresh = 18;
          if (Math.hypot(pos.x - p0.x, pos.y - p0.y) < thresh) draggingPt = p0;
          else if (Math.hypot(pos.x - p1.x, pos.y - p1.y) < thresh) draggingPt = p1;
          else if (Math.hypot(pos.x - p2.x, pos.y - p2.y) < thresh) draggingPt = p2;
          else if (Math.hypot(pos.x - p3.x, pos.y - p3.y) < thresh) draggingPt = p3;
        });

        window.addEventListener("mousemove", (e) => {
          if (draggingPt) {
            const pos = getPos(e);
            draggingPt.x = pos.x;
            draggingPt.y = pos.y;
            if (bHud) {
              const radius = Math.hypot(p1.x - p0.x, p1.y - p0.y).toFixed(1);
              bHud.textContent = `Bracket Radius: ${radius}px`;
            }
            drawB();
          }
        });

        window.addEventListener("mouseup", () => {
          draggingPt = null;
        });

        const presetBtns = document.querySelectorAll("[data-preset]");
        presetBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            presetBtns.forEach((b) => b.classList.remove("active"));
            const target = e.currentTarget as HTMLElement;
            target.classList.add("active");
            const preset = target.dataset.preset;

            const rect = bCanvas.getBoundingClientRect();
            const sx = rect.width / 420;
            const sy = rect.height / 220;

            if (preset === "bracketed") {
              p0 = { x: 60 * sx, y: 170 * sy };
              p1 = { x: 130 * sx, y: 170 * sy };
              p2 = { x: 180 * sx, y: 90 * sy };
              p3 = { x: 180 * sx, y: 35 * sy };
              if (bHud) bHud.textContent = "Garamond / Georgia: Sturdy Curved Bracket";
            } else if (preset === "hairline") {
              p0 = { x: 60 * sx, y: 170 * sy };
              p1 = { x: 175 * sx, y: 170 * sy };
              p2 = { x: 180 * sx, y: 165 * sy };
              p3 = { x: 180 * sx, y: 35 * sy };
              if (bHud) bHud.textContent = "Didot / Bodoni: Unbracketed Hairline Serif";
            } else if (preset === "slab") {
              p0 = { x: 60 * sx, y: 170 * sy };
              p1 = { x: 180 * sx, y: 170 * sy };
              p2 = { x: 180 * sx, y: 170 * sy };
              p3 = { x: 180 * sx, y: 35 * sy };
              if (bHud) bHud.textContent = "Rockwell: Heavy Slab Block Serif";
            }
            drawB();
          });
        });

        window.addEventListener("resize", resizeB);
        setTimeout(resizeB, 50);
      }

      // -------------------------------------------------------------
      // 2. SCANLINE RAY CASTING CANVAS
      // -------------------------------------------------------------
      const scCanvas = document.getElementById("scanline-canvas") as HTMLCanvasElement | null;
      const scSlider = document.getElementById("scanline-slider") as HTMLInputElement | null;
      const scVal = document.getElementById("scanline-val");
      const scHud = document.getElementById("scanline-hud");

      if (scCanvas && scSlider) {
        const ctx = scCanvas.getContext("2d");

        const updateScanline = () => {
          if (!ctx) return;
          const rect = scCanvas.getBoundingClientRect();
          scCanvas.width = rect.width * dpr;
          scCanvas.height = rect.height * dpr;
          const w = scCanvas.width;
          const h = scCanvas.height;

          const rayY = parseInt(scSlider.value, 10) * dpr;
          if (scVal) scVal.textContent = `Y: ${Math.round(rayY / dpr)} px`;

          const dark = document.documentElement.classList.contains("dark");
          ctx.clearRect(0, 0, w, h);

          const centerX = w / 2;
          const topY = 25 * dpr;
          const botY = h - 30 * dpr;
          const baseW = 100 * dpr;

          ctx.fillStyle = dark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.06)";
          ctx.beginPath();
          ctx.moveTo(centerX, topY);
          ctx.lineTo(centerX + baseW, botY);
          ctx.lineTo(centerX + baseW - 30 * dpr, botY);
          ctx.lineTo(centerX + 18 * dpr, topY + 95 * dpr);
          ctx.lineTo(centerX - 18 * dpr, topY + 95 * dpr);
          ctx.lineTo(centerX - baseW + 30 * dpr, botY);
          ctx.lineTo(centerX - baseW, botY);
          ctx.closePath();

          ctx.moveTo(centerX, topY + 35 * dpr);
          ctx.lineTo(centerX + 12 * dpr, topY + 75 * dpr);
          ctx.lineTo(centerX - 12 * dpr, topY + 75 * dpr);
          ctx.closePath();
          ctx.fill("evenodd");

          ctx.strokeStyle = "#0284c7";
          ctx.lineWidth = 2 * dpr;
          ctx.stroke();

          ctx.strokeStyle = "#f59e0b";
          ctx.lineWidth = 1.5 * dpr;
          ctx.beginPath();
          ctx.moveTo(0, rayY);
          ctx.lineTo(w, rayY);
          ctx.stroke();

          let count = 0;
          if (rayY >= topY && rayY <= botY) {
            const factor = (rayY - topY) / (botY - topY);
            const outerLeft = centerX - factor * baseW;
            const outerRight = centerX + factor * baseW;

            ctx.fillStyle = "#f59e0b";
            ctx.beginPath();
            ctx.arc(outerLeft, rayY, 4 * dpr, 0, Math.PI * 2);
            ctx.arc(outerRight, rayY, 4 * dpr, 0, Math.PI * 2);
            ctx.fill();
            count += 2;

            if (rayY >= topY + 35 * dpr && rayY <= topY + 75 * dpr) {
              const counterFactor = (rayY - (topY + 35 * dpr)) / (40 * dpr);
              const innerLeft = centerX - counterFactor * 12 * dpr;
              const innerRight = centerX + counterFactor * 12 * dpr;

              ctx.beginPath();
              ctx.arc(innerLeft, rayY, 4 * dpr, 0, Math.PI * 2);
              ctx.arc(innerRight, rayY, 4 * dpr, 0, Math.PI * 2);
              ctx.fill();
              count += 2;

              ctx.fillStyle = "rgba(245, 158, 11, 0.35)";
              ctx.fillRect(outerLeft, rayY - 2 * dpr, innerLeft - outerLeft, 4 * dpr);
              ctx.fillRect(innerRight, rayY - 2 * dpr, outerRight - innerRight, 4 * dpr);
            } else {
              ctx.fillStyle = "rgba(245, 158, 11, 0.35)";
              ctx.fillRect(outerLeft, rayY - 2 * dpr, outerRight - outerLeft, 4 * dpr);
            }
          }

          if (scHud) {
            scHud.textContent = `Scanline Y: ${Math.round(rayY / dpr)}px • Intersections: ${count} • Spans: ${count > 2 ? "Dual (Hollow Counter)" : count === 2 ? "Solid" : "Empty"}`;
          }
        };

        scSlider.addEventListener("input", updateScanline);
        window.addEventListener("resize", updateScanline);
        setTimeout(updateScanline, 55);
      }

      // -------------------------------------------------------------
      // 3. DROPOUT SIMULATOR (CLEAN MINIMAL, NO RED BOXES)
      // -------------------------------------------------------------
      const dropCanvas = document.getElementById("dropout-canvas") as HTMLCanvasElement | null;
      const sizeSlider = document.getElementById("dropout-size-slider") as HTMLInputElement | null;
      const sizeVal = document.getElementById("dropout-size-val");
      const dropHud = document.getElementById("dropout-hud");

      if (dropCanvas && sizeSlider) {
        const ctx = dropCanvas.getContext("2d");

        const updateDrop = () => {
          if (!ctx) return;
          const rect = dropCanvas.getBoundingClientRect();
          dropCanvas.width = rect.width * dpr;
          dropCanvas.height = rect.height * dpr;
          const w = dropCanvas.width;
          const h = dropCanvas.height;

          const size = parseInt(sizeSlider.value, 10);
          if (sizeVal) sizeVal.textContent = `${size} px (${size < 16 ? "Low Resolution Body Size" : "High Resolution Display"})`;

          const dark = document.documentElement.classList.contains("dark");
          ctx.clearRect(0, 0, w, h);

          // Divider Line
          ctx.strokeStyle = dark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.08)";
          ctx.lineWidth = 1 * dpr;
          ctx.beginPath();
          ctx.moveTo(w / 2, 0);
          ctx.lineTo(w / 2, h);
          ctx.stroke();

          // Left Label: Bodoni
          ctx.fillStyle = dark ? "#a1a1aa" : "#71717a";
          ctx.font = `${11 * dpr}px 'Host Grotesk', sans-serif`;
          ctx.textAlign = "center";
          ctx.fillText("Classical Didone (Bodoni)", w / 4, 30 * dpr);
          ctx.fillText("Screen Serif (Georgia)", (w * 3) / 4, 30 * dpr);

          const hairlineBodoni = (size / 8.5) * 0.18;
          const hairlineGeorgia = Math.max(1.0, (size / 2.8) * 0.22);
          const letterScale = Math.min(70, Math.max(16, size * 2.2)) * dpr;

          // Render Bodoni on Left
          ctx.font = `bold ${letterScale}px 'Bodoni Moda', serif`;
          ctx.textBaseline = "middle";

          if (hairlineBodoni < 0.52) {
            // Draw Bodoni stems with severed broken crossbar (actual dropout simulation)
            const glyphY = h / 2 - 5 * dpr;
            const stemW = Math.max(2, size * 0.22) * dpr;
            const glyphH = letterScale * 0.7;

            ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
            // Left stem
            ctx.fillRect(w / 4 - 22 * dpr, glyphY - glyphH / 2, stemW, glyphH);
            // Right stem
            ctx.fillRect(w / 4 + 22 * dpr - stemW, glyphY - glyphH / 2, stemW, glyphH);
          } else {
            ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
            ctx.fillText("H", w / 4, h / 2 - 5 * dpr);
          }

          // Render Georgia on Right
          ctx.font = `bold ${letterScale}px 'Newsreader', 'Georgia', serif`;
          ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
          ctx.fillText("H", (w * 3) / 4, h / 2 - 5 * dpr);

          if (dropHud) {
            if (hairlineBodoni < 0.52) {
              dropHud.textContent = `At ${size}px: Bodoni hairlines fall below 0.5px and drop out • Georgia maintains ${hairlineGeorgia.toFixed(1)}px solid stems`;
            } else {
              dropHud.textContent = `At ${size}px: Sufficient pixel density for both typefaces`;
            }
          }
        };

        sizeSlider.addEventListener("input", updateDrop);
        window.addEventListener("resize", updateDrop);
        setTimeout(updateDrop, 60);
      }

      // -------------------------------------------------------------
      // 4. TRUETYPE BYTECODE SNAPPING SIMULATOR
      // -------------------------------------------------------------
      const hCanvas = document.getElementById("hinting-canvas") as HTMLCanvasElement | null;
      const stemSlider = document.getElementById("stem-slider") as HTMLInputElement | null;
      const stemVal = document.getElementById("stem-offset-val");
      const hintHud = document.getElementById("hinting-hud");
      let hintMode = "cleartype";

      if (hCanvas && stemSlider) {
        const ctx = hCanvas.getContext("2d");

        const updateHint = () => {
          if (!ctx) return;
          const rect = hCanvas.getBoundingClientRect();
          hCanvas.width = rect.width * dpr;
          hCanvas.height = rect.height * dpr;
          const w = hCanvas.width;
          const h = hCanvas.height;

          const offset = parseInt(stemSlider.value, 10) / 100;
          if (stemVal) stemVal.textContent = `Offset: ${offset.toFixed(2)} px`;

          const dark = document.documentElement.classList.contains("dark");
          ctx.clearRect(0, 0, w, h);

          const cols = 24;
          const cellW = w / cols;
          const cellH = cellW;
          const rows = Math.ceil(h / cellH);

          ctx.strokeStyle = dark ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 0, 0, 0.05)";
          for (let c = 0; c <= cols; c++) {
            ctx.beginPath();
            ctx.moveTo(c * cellW, 0);
            ctx.lineTo(c * cellW, h);
            ctx.stroke();
          }

          const rawStemCenter = 11 + offset;
          const stemWidth = 2.6;

          if (hintMode === "vector") {
            const x1 = (rawStemCenter - stemWidth / 2) * cellW;
            const x2 = (rawStemCenter + stemWidth / 2) * cellW;
            const y1 = 3 * cellH;
            const y2 = (rows - 3) * cellH;

            ctx.fillStyle = "#0284c7";
            ctx.fillRect(x1, y1, x2 - x1, y2 - y1);
            ctx.fillRect(x1 - cellW, y1, (x2 - x1) + cellW * 2, cellH * 0.7);
            ctx.fillRect(x1 - cellW, y2 - cellH * 0.7, (x2 - x1) + cellW * 2, cellH * 0.7);

            if (hintHud) hintHud.textContent = `Continuous Vector (Exact Math Pos: ${(11 + offset).toFixed(2)})`;
          } else if (hintMode === "mono") {
            for (let r = 3; r < rows - 3; r++) {
              for (let c = 0; c < cols; c++) {
                const dist = Math.abs(c + 0.5 - rawStemCenter);
                if (dist < stemWidth / 2) {
                  ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
                  ctx.fillRect(c * cellW + 1, r * cellH + 1, cellW - 2, cellH - 2);
                }
              }
            }
            if (hintHud) hintHud.textContent = `1-Bit Threshold: Staircase Jumps Across Columns`;
          } else if (hintMode === "quartz") {
            for (let r = 3; r < rows - 3; r++) {
              for (let c = 0; c < cols; c++) {
                const dist = Math.abs(c + 0.5 - rawStemCenter);
                const coverage = Math.max(0, Math.min(1, (stemWidth / 2 + 0.5) - dist));
                if (coverage > 0) {
                  ctx.fillStyle = dark ? `rgba(244, 244, 245, ${coverage * 0.95})` : `rgba(24, 24, 27, ${coverage * 0.95})`;
                  ctx.fillRect(c * cellW + 1, r * cellH + 1, cellW - 2, cellH - 2);
                }
              }
            }
            if (hintHud) hintHud.textContent = `Apple Quartz 2D: Smooth Grayscale Anti-Aliasing`;
          } else if (hintMode === "cleartype") {
            const snappedCol = Math.round(rawStemCenter);
            for (let r = 3; r < rows - 3; r++) {
              for (let c = snappedCol - 1; c <= snappedCol; c++) {
                ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
                ctx.fillRect(c * cellW + 1, r * cellH + 1, cellW - 2, cellH - 2);
              }
            }

            ctx.strokeStyle = "#0284c7";
            ctx.lineWidth = 2 * dpr;
            ctx.beginPath();
            ctx.moveTo(rawStemCenter * cellW, h / 2);
            ctx.lineTo(snappedCol * cellW, h / 2);
            ctx.stroke();

            if (hintHud) hintHud.textContent = `TrueType Opcode MDAP: Snapped ${offset.toFixed(2)}px to Column ${snappedCol}`;
          }
        };

        stemSlider.addEventListener("input", updateHint);

        const modeBtns = document.querySelectorAll(".hint-mode-btn");
        modeBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            modeBtns.forEach((b) => b.classList.remove("active"));
            const target = e.currentTarget as HTMLElement;
            target.classList.add("active");
            hintMode = target.dataset.mode || "cleartype";
            updateHint();
          });
        });

        window.addEventListener("resize", updateHint);
        setTimeout(updateHint, 70);
      }

      // -------------------------------------------------------------
      // 5. 40X LCD SUBPIXEL PHOSPHOR MICROSCOPE
      // -------------------------------------------------------------
      const sCanvas = document.getElementById("subpixel-canvas") as HTMLCanvasElement | null;
      const subInput = document.getElementById("subpixel-input") as HTMLInputElement | null;
      const subHud = document.getElementById("subpixel-hud");
      let activeFilter = "cleartype";

      if (sCanvas && subInput) {
        const ctx = sCanvas.getContext("2d");

        const updateSub = () => {
          if (!ctx) return;
          const rect = sCanvas.getBoundingClientRect();
          sCanvas.width = rect.width * dpr;
          sCanvas.height = rect.height * dpr;
          const w = sCanvas.width;
          const h = sCanvas.height;

          const char = subInput.value.trim() || "R";

          ctx.clearRect(0, 0, w, h);

          const pixelCols = 22;
          const pixelW = w / pixelCols;
          const pixelH = pixelW;
          const pixelRows = Math.ceil(h / pixelH);

          const offW = pixelCols * 3;
          const offH = pixelRows;
          const off = document.createElement("canvas");
          off.width = offW;
          off.height = offH;
          const offCtx = off.getContext("2d");
          if (!offCtx) return;

          offCtx.fillStyle = "#000";
          offCtx.fillRect(0, 0, offW, offH);
          offCtx.fillStyle = "#fff";
          offCtx.font = `bold ${Math.floor(offH * 0.78)}px 'Newsreader', 'Georgia', serif`;
          offCtx.textAlign = "center";
          offCtx.textBaseline = "middle";
          offCtx.fillText(char, offW / 2, offH / 2);

          const rawData = offCtx.getImageData(0, 0, offW, offH).data;

          for (let r = 0; r < pixelRows; r++) {
            for (let c = 0; c < pixelCols; c++) {
              const px = c * pixelW;
              const py = r * pixelH;

              const rVal = rawData[(r * offW + (c * 3)) * 4] / 255;
              const gVal = rawData[(r * offW + (c * 3 + 1)) * 4] / 255;
              const bVal = rawData[(r * offW + (c * 3 + 2)) * 4] / 255;

              if (activeFilter === "grayscale") {
                const avg = (rVal + gVal + bVal) / 3;
                ctx.fillStyle = `rgba(24, 24, 27, ${avg * 0.95 + 0.03})`;
                ctx.fillRect(px + 1, py + 1, pixelW - 2, pixelH - 2);
              } else if (activeFilter === "raw") {
                ctx.fillStyle = `rgba(239, 68, 68, ${rVal * 0.92 + 0.08})`;
                ctx.fillRect(px, py, pixelW * 0.31, pixelH - 1);
                ctx.fillStyle = `rgba(34, 197, 94, ${gVal * 0.92 + 0.08})`;
                ctx.fillRect(px + pixelW * 0.34, py, pixelW * 0.31, pixelH - 1);
                ctx.fillStyle = `rgba(59, 130, 246, ${bVal * 0.92 + 0.08})`;
                ctx.fillRect(px + pixelW * 0.68, py, pixelW * 0.31, pixelH - 1);
              } else {
                ctx.fillStyle = `rgba(239, 68, 68, ${rVal * 0.82 + 0.08})`;
                ctx.fillRect(px, py, pixelW * 0.31, pixelH - 1);
                ctx.fillStyle = `rgba(34, 197, 94, ${gVal * 0.82 + 0.08})`;
                ctx.fillRect(px + pixelW * 0.34, py, pixelW * 0.31, pixelH - 1);
                ctx.fillStyle = `rgba(59, 130, 246, ${bVal * 0.82 + 0.08})`;
                ctx.fillRect(px + pixelW * 0.68, py, pixelW * 0.31, pixelH - 1);
              }
            }
          }
        };

        subInput.addEventListener("input", updateSub);

        const filterBtns = document.querySelectorAll(".subpixel-btn");
        filterBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            filterBtns.forEach((b) => b.classList.remove("active"));
            const target = e.currentTarget as HTMLElement;
            target.classList.add("active");
            activeFilter = target.dataset.filter || "cleartype";
            if (subHud) {
              subHud.textContent = activeFilter === "cleartype" ? "ClearType FIR Filtered: Clean Edge Luminance" : activeFilter === "raw" ? "Raw Subpixel: Severe Chromatic Fringing" : "Grayscale Anti-Aliasing: Standard Blur";
            }
            updateSub();
          });
        });

        window.addEventListener("resize", updateSub);
        setTimeout(updateSub, 80);
      }

      // -------------------------------------------------------------
      // 6. SCREEN FONT ANATOMY COMPARATOR
      // -------------------------------------------------------------
      const aCanvas = document.getElementById("anatomy-canvas") as HTMLCanvasElement | null;
      const aHud = document.getElementById("anatomy-hud");
      let anatomyFont = "georgia";
      let anatomyChar = "e";

      if (aCanvas) {
        const ctx = aCanvas.getContext("2d");

        const updateAnatomy = () => {
          if (!ctx) return;
          const rect = aCanvas.getBoundingClientRect();
          aCanvas.width = rect.width * dpr;
          aCanvas.height = rect.height * dpr;
          const w = aCanvas.width;
          const h = aCanvas.height;

          const dark = document.documentElement.classList.contains("dark");
          ctx.clearRect(0, 0, w, h);

          const centerY = h * 0.52;
          const fontFace = anatomyFont === "bodoni" ? "'Bodoni Moda', serif" : anatomyFont === "garamond" ? "'Fraunces', serif" : "'Newsreader', 'Georgia', serif";
          const fontSize = Math.floor(100 * dpr);

          // Metric guide lines
          const baselineY = centerY + 30 * dpr;
          const xHeightRatio = anatomyFont === "bodoni" ? 0.48 : anatomyFont === "garamond" ? 0.52 : 0.68;
          const xHeightY = baselineY - (fontSize * xHeightRatio * 0.7);
          const capHeightY = baselineY - (fontSize * 0.72);

          ctx.strokeStyle = dark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.08)";
          ctx.lineWidth = 1 * dpr;

          // Cap height line
          ctx.beginPath();
          ctx.moveTo(30 * dpr, capHeightY);
          ctx.lineTo(w - 30 * dpr, capHeightY);
          ctx.stroke();

          // x-Height line (Accentuated)
          ctx.strokeStyle = "#0284c7";
          ctx.setLineDash([4 * dpr, 4 * dpr]);
          ctx.beginPath();
          ctx.moveTo(30 * dpr, xHeightY);
          ctx.lineTo(w - 30 * dpr, xHeightY);
          ctx.stroke();
          ctx.setLineDash([]);

          // Baseline
          ctx.strokeStyle = dark ? "rgba(255, 255, 255, 0.15)" : "rgba(0, 0, 0, 0.15)";
          ctx.beginPath();
          ctx.moveTo(30 * dpr, baselineY);
          ctx.lineTo(w - 30 * dpr, baselineY);
          ctx.stroke();

          // Metric text labels
          ctx.fillStyle = "#0284c7";
          ctx.font = `${9 * dpr}px 'Host Grotesk', sans-serif`;
          ctx.textAlign = "left";
          ctx.fillText(`X-HEIGHT (${(xHeightRatio * 100).toFixed(0)}%)`, 34 * dpr, xHeightY - 4 * dpr);

          ctx.fillStyle = dark ? "#71717a" : "#a1a1aa";
          ctx.fillText("BASELINE", 34 * dpr, baselineY + 12 * dpr);

          // Draw the character
          ctx.font = `500 ${fontSize}px ${fontFace}`;
          ctx.textAlign = "center";
          ctx.textBaseline = "alphabetic";
          ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
          ctx.fillText(anatomyChar, w / 2, baselineY);

          if (aHud) {
            if (anatomyFont === "georgia") {
              aHud.textContent = `Georgia: Tall x-Height (68%) • Large Counter Volume for Screen Pixels`;
            } else if (anatomyFont === "bodoni") {
              aHud.textContent = `Bodoni: Compact x-Height (48%) • Compressed Print Proportions`;
            } else {
              aHud.textContent = `Garamond: Classical Oldstyle x-Height (52%) • Moderate Openness`;
            }
          }
        };

        const fontBtns = document.querySelectorAll(".anatomy-btn");
        fontBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            fontBtns.forEach((b) => b.classList.remove("active"));
            const target = e.currentTarget as HTMLElement;
            target.classList.add("active");
            anatomyFont = target.dataset.font || "georgia";
            updateAnatomy();
          });
        });

        const charBtns = document.querySelectorAll(".anatomy-char-btn");
        charBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            charBtns.forEach((b) => b.classList.remove("active"));
            const target = e.currentTarget as HTMLElement;
            target.classList.add("active");
            anatomyChar = target.dataset.char || "e";
            updateAnatomy();
          });
        });

        window.addEventListener("resize", updateAnatomy);
        setTimeout(updateAnatomy, 85);
      }

      // -------------------------------------------------------------
      // 7. VARIABLE FONT OPTICAL SIZING MORPH CANVAS
      // -------------------------------------------------------------
      const mCanvas = document.getElementById("morph-canvas") as HTMLCanvasElement | null;
      const morphSlider = document.getElementById("morph-slider") as HTMLInputElement | null;
      const morphSizeVal = document.getElementById("morph-size-val");
      const morphHud = document.getElementById("morph-hud");

      if (mCanvas && morphSlider) {
        const ctx = mCanvas.getContext("2d");

        const updateMorph = () => {
          if (!ctx) return;
          const rect = mCanvas.getBoundingClientRect();
          mCanvas.width = rect.width * dpr;
          mCanvas.height = rect.height * dpr;
          const w = mCanvas.width;
          const h = mCanvas.height;

          const opsz = parseInt(morphSlider.value, 10);
          if (morphSizeVal) morphSizeVal.textContent = `${opsz} pt`;

          const factor = (opsz - 6) / (72 - 6);
          const stemThickness = (28 - factor * 16) * dpr;
          const hairlineThickness = (12 - factor * 10) * dpr;
          const bracketRadius = (24 - factor * 20) * dpr;

          const dark = document.documentElement.classList.contains("dark");
          ctx.clearRect(0, 0, w, h);

          ctx.strokeStyle = dark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.08)";
          ctx.lineWidth = 1 * dpr;
          ctx.beginPath();
          ctx.moveTo(40 * dpr, 45 * dpr);
          ctx.lineTo(w - 40 * dpr, 45 * dpr);
          ctx.moveTo(40 * dpr, h - 45 * dpr);
          ctx.lineTo(w - 40 * dpr, h - 45 * dpr);
          ctx.stroke();

          ctx.fillStyle = dark ? "#71717a" : "#a1a1aa";
          ctx.font = `${10 * dpr}px 'Host Grotesk', sans-serif`;
          ctx.textAlign = "left";
          ctx.fillText("CAP HEIGHT", 45 * dpr, 40 * dpr);
          ctx.fillText("BASELINE", 45 * dpr, h - 35 * dpr);

          const centerX = w / 2;
          const topY = 45 * dpr;
          const botY = h - 45 * dpr;

          ctx.fillStyle = dark ? "#f4f4f5" : "#18181b";
          ctx.beginPath();

          const stemLeft = centerX - 90 * dpr;
          ctx.rect(stemLeft, topY, stemThickness, botY - topY);
          ctx.rect(stemLeft - bracketRadius, topY, stemThickness + bracketRadius * 2, hairlineThickness * 1.5);
          ctx.rect(stemLeft - bracketRadius, botY - hairlineThickness * 1.5, stemThickness + bracketRadius * 2, hairlineThickness * 1.5);

          const loopRadius = 40 * dpr;
          ctx.arc(stemLeft + stemThickness + loopRadius, topY + loopRadius + 10 * dpr, loopRadius, -Math.PI / 2, Math.PI / 2);
          ctx.fill();

          const contrastRatio = (stemThickness / Math.max(1, hairlineThickness)).toFixed(1);

          if (morphHud) {
            if (opsz <= 10) {
              morphHud.textContent = `${opsz}pt Caption: Sturdy Hairlines (${hairlineThickness.toFixed(1)}px) • Contrast: ${contrastRatio}:1`;
            } else if (opsz >= 48) {
              morphHud.textContent = `${opsz}pt Display: Razor Hairlines (${hairlineThickness.toFixed(1)}px) • Contrast: ${contrastRatio}:1`;
            } else {
              morphHud.textContent = `${opsz}pt Body Text: Balanced Proportions • Contrast: ${contrastRatio}:1`;
            }
          }
        };

        morphSlider.addEventListener("input", updateMorph);
        window.addEventListener("resize", updateMorph);
        setTimeout(updateMorph, 90);
      }
    }

    document.addEventListener("astro:page-load", initScreenTypoLab);
    initScreenTypoLab();
  </script>
</Layout>
