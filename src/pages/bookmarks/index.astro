---
import { SITE_DESCRIPTION } from "../../consts";
import type { Bookmark, BookmarkCategory } from "../../data/bookmarks";
import { bookmarks as baseBookmarks } from "../../data/bookmarks";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

function withCategories(
  b: Bookmark,
): Bookmark & { categories: BookmarkCategory[] } {
  const cats = b.categories?.length
    ? b.categories
    : b.type === "image"
      ? (["photography"] as BookmarkCategory[])
      : b.type === "video"
        ? (["tools"] as BookmarkCategory[])
        : (["design"] as BookmarkCategory[]);
  return { ...b, categories: cats };
}

const bookmarks = baseBookmarks.map(withCategories);

const items = bookmarks.filter((b) => {
  if (b.type === "link") return !!b.url;
  if (b.type === "video") return !!b.url;
  if (b.type === "image") return !!b.image;
  return false;
});
---

<Layout
  title="Farooq Q. | Bookmarks"
  description={SITE_DESCRIPTION}
>
  <div>
    <!-- Filter Bar (Links default) -->
    <nav class="filter-nav mb-8 flex items-center gap-2 text-[15px]" aria-label="Filter bookmarks">
      <button type="button" class="filter-link" data-tab="link">Links</button>
      <span class="filter-sep">/</span>
      <button type="button" class="filter-link" data-tab="video">Videos</button>
    </nav>

    <!-- Main Content Container -->
    <div class="bookmarks-wrapper">
      {/* 1. Links Section - Written prose style */}
      <section class="bookmark-section" data-type-section="link">
        <ul class="space-y-3 text-[15px] leading-[1.65]">
          {items.filter(i => i.type === "link").map((item) => (
            <li class="bookmark-item py-0.5" data-type="link">
              {item.writtenText ? (
                <span set:html={item.writtenText} />
              ) : (
                <span>
                  this article from{" "}
                  <a href={item.url} target="_blank" rel="noopener">
                    {item.domain || item.title}
                  </a>
                  {item.title && item.title !== item.domain && (
                    <span> &mdash; <a href={item.url} target="_blank" rel="noopener">{item.title}</a></span>
                  )}
                  {item.description && (
                    <span> ({item.description})</span>
                  )}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>

      {/* 2. Videos Section - Written text links */}
      <section class="bookmark-section" data-type-section="video">
        <ul class="space-y-3 text-[15px] leading-[1.65]">
          {items.filter(i => i.type === "video").map((item) => (
            <li class="bookmark-item py-0.5" data-type="video">
              {item.writtenText ? (
                <span set:html={item.writtenText} />
              ) : (
                <span>
                  this video from{" "}
                  <a href={item.url} target="_blank" rel="noopener">
                    {item.domain || "youtube.com"}
                  </a>
                  <span> &mdash; <a href={item.url} target="_blank" rel="noopener">{item.title}</a></span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <style>
    .filter-nav {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 2rem;
    }
    .filter-link {
      font-size: 15px !important;
      line-height: 1.65;
      color: var(--text-muted) !important;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      text-decoration: none !important;
      transition: color 150ms ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .filter-link:hover {
        color: var(--text-color) !important;
      }
    }
    .filter-link.is-active {
      color: var(--text-color) !important;
      font-weight: 400;
      text-decoration: none !important;
      background-image: none !important;
    }
    .bookmark-section a {
      color: var(--text-color) !important;
      text-decoration: underline !important;
      text-decoration-color: var(--text-color) !important;
      text-decoration-thickness: 1px !important;
      text-underline-offset: 3.5px !important;
      transition: font-style 120ms ease, text-decoration-thickness 120ms ease !important;
    }
    @media (hover: hover) and (pointer: fine) {
      .bookmark-section a:hover {
        font-style: italic !important;
        text-decoration-thickness: 1.5px !important;
      }
    }
  </style>

  <script>
    function initBookmarks() {
      const tabs = Array.from(document.querySelectorAll(".filter-link"));
      const sections = Array.from(document.querySelectorAll(".bookmark-section"));

      if (!tabs.length || !sections.length) return;

      const setActive = (name: string) => {
        tabs.forEach((t) => {
          const isAct = (t as HTMLElement).dataset.tab === name;
          t.classList.toggle("is-active", isAct);
        });

        sections.forEach((sec) => {
          const typeSec = (sec as HTMLElement).dataset.typeSection;
          const show = typeSec === name;
          (sec as HTMLElement).style.display = show ? "block" : "none";
        });
      };

      tabs.forEach((t) => {
        t.addEventListener("click", () => {
          const tabName = (t as HTMLElement).dataset.tab;
          if (tabName) setActive(tabName);
        });
      });

      // Default active tab is 'link'
      setActive("link");
    }

    document.addEventListener("astro:page-load", initBookmarks);
    initBookmarks();
  </script>
</Layout>
