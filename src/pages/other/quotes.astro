---
import { quotes } from "../../data/quotes";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Farooq Q. | Quotes" description="Quotes I find meaningful">
  <main>
    <div class="quotes-container">
      {
        quotes.map((quote) => (
          <blockquote class="quote-item">
            <p class="quote-text">"{quote.text}"</p>
            <cite class="quote-author">— {quote.author}</cite>
          </blockquote>
        ))
      }
    </div>
  </main>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    .quotes-container {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 0.5rem;
    }

    .quote-item {
      margin: 0;
      padding: 0;
      border: none;
    }

    .quote-text {
      font-size: 0.9375rem;
      line-height: 1.6;
      margin: 0 0 0.25rem 0;
      color: #111111;
    }

    :global(html.dark) .quote-text {
      color: #e4e4e7;
    }

    .quote-author {
      font-size: 0.8125rem;
      font-style: normal;
      color: #71717a;
      display: block;
    }

    :global(html.dark) .quote-author {
      color: #a1a1aa;
    }
  </style>
</Layout>
