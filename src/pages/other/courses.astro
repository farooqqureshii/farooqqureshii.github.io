---
import Layout from "../../layouts/Layout.astro";

const courses: { title: string; detail: string }[] = [
  { title: "CHM 1311: Principles of Chemistry", detail: "5/10" },
  { title: "GNG 1105: Engineering Mechanics", detail: "10/10" },
  { title: "ITI 1120: Introduction to Computing I", detail: "9/10" },
