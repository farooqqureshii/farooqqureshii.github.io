  { title: "MAT 1320: Calculus I", detail: "3/10" },
  { title: "MAT 1322: Calculus II", detail: "4/10" },
  { title: "GNG 1103: Introduction to Engineering Design", detail: "4/10" },
  { title: "ENG 1112: Technical Report Writing", detail: "3/10" },
  { title: "ITI 1100: Digital Systems I", detail: "4/10" },
  { title: "PHY 1124: Fundamentals of Physics for Engineers", detail: "9/10" },
  { title: "PHI 2394: Scientific Thought and Social Values", detail: "3/10" },
  {
    title:
      "MAT 2384: Ordinary Differential Equations, Laplace Transforms and Numerical Methods",
    detail: "3/10",
  },
  { title: "MAT 2322: Calculus III for Engineers", detail: "7/10" },
  { title: "CEG 2136: Computer Architecture I", detail: "9/10" },
  { title: "ADM 1100: Introduction to Business", detail: "4/10" },
  { title: "ELG 2138: Circuit Theory I", detail: "6/10" },
  { title: "ELG 2136: Electronics I", detail: "9/10" },
