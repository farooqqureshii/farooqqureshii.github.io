// Shuffle books deterministically
const sortedBooks = [...books].sort((a, b) => {
  const hashA = (a.title.charCodeAt(0) * 31 + a.author.charCodeAt(0) * 17) % 97;
  const hashB = (b.title.charCodeAt(0) * 31 + b.author.charCodeAt(0) * 17) % 97;
  return hashA - hashB;
});

const filterTabs = [
  { label: "All", value: "all" },
  { label: "5 Stars", value: "5-star" },
  { label: "Fiction", value: "fiction" },
  { label: "Non-Fiction", value: "non-fiction" },
  { label: "Sci-Fi", value: "sci-fi" },
  { label: "Memoir", value: "memoir" },
];
---

<Layout title="Farooq Q. | Books" description="Books read by Farooq Qureshi">
  <main class="no-link-underline">
    <!-- Filter Tabs -->
    <nav class="filter-nav mb-6 flex flex-wrap items-center gap-2 text-sm" aria-label="Filter books">
      {
        filterTabs.map((tab, i) => (
          <>
            {i > 0 && <span class="filter-sep">/</span>}
            <button
              type="button"
              class={`filter-link ${i === 0 ? "is-active" : ""}`}
              data-tab={tab.value}
            >
              {tab.label}
            </button>
          </>
        ))
      }
    </nav>

    <!-- Books List -->
    <div class="space-y-2.5 text-sm">
      {
        sortedBooks.map((book) => {
          const g = book.genre.toLowerCase();
          const is5Star = book.rating === 5;
          const isNonFiction = g.includes("non-fiction");
          const isFiction = g.includes("fiction") && !isNonFiction;
          const isSciFi = g.includes("sci-fi");
          const isMemoir = g.includes("memoir") || g.includes("essay") || g.includes("biography");

          const tags = [
            "all",
            is5Star ? "5-star" : "",
            isFiction ? "fiction" : "",
            isNonFiction ? "non-fiction" : "",
            isSciFi ? "sci-fi" : "",
            isMemoir ? "memoir" : "",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <div
              class="book-row flex items-baseline justify-between gap-4"
              data-tags={tags}
            >
              <span class="text-zinc-900 dark:text-zinc-100 min-w-0">
                {book.title} — {book.author}
              </span>
              <span class="shrink-0 text-xs text-zinc-400 select-none dark:text-zinc-500">
                {"★".repeat(book.rating)}{"☆".repeat(5 - book.rating)}
              </span>
            </div>
          );
        })
      }
    </div>
  </main>

  <style>
    .filter-nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .filter-link {
      font-size: 0.875rem;
      color: #71717a;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: color 150ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    html.dark .filter-link {
      color: #a1a1aa;
    }
    @media (hover: hover) and (pointer: fine) {
      .filter-link:hover {
        color: #111111;
      }
      html.dark .filter-link:hover {
        color: #ffffff;
      }
    }
    .filter-link.is-active {
      color: #111111 !important;
      font-weight: 500;
    }
    html.dark .filter-link.is-active {
      color: #ffffff !important;
    }
    .filter-sep {
      font-size: 0.875rem;
      color: #e4e4e7;
      user-select: none;
    }
    html.dark .filter-sep {
      color: #3f3f46;
    }
  </style>

  <script>
    function initBooksFilter() {
      const tabs = Array.from(document.querySelectorAll(".filter-link"));
      const rows = Array.from(document.querySelectorAll(".book-row"));

      if (!tabs.length || !rows.length) return;

      const setActive = (tabName: string) => {
        tabs.forEach((tab) => {
          const isAct = (tab as HTMLElement).dataset.tab === tabName;
          tab.classList.toggle("is-active", isAct);
        });

        rows.forEach((row) => {
          const tags = ((row as HTMLElement).dataset.tags || "").split(" ");
          const show = tabName === "all" || tags.includes(tabName);
          (row as HTMLElement).style.display = show ? "flex" : "none";
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const tabName = (tab as HTMLElement).dataset.tab;
          if (tabName) setActive(tabName);
        });
      });
    }

    document.addEventListener("astro:page-load", initBooksFilter);
    initBooksFilter();
  </script>
</Layout>
