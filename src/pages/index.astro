---
import { SITE_DESCRIPTION } from "../consts";
import IndexLayout from "../layouts/IndexLayout.astro";
import HandwrittenSignoff from "../components/HandwrittenSignoff.astro";
---

<IndexLayout title="Farooq Q." description={SITE_DESCRIPTION}>
  <main class="index-page">
    <article class="index-content space-y-4 text-[15px] leading-[1.65]">
      <p>
        I'm a third-year Electrical Engineering student at <a
          href="https://uottawa.ca"
          target="_blank"
          rel="noopener">the University of Ottawa</a
        >.
      </p>
      <p>
        This past summer, I worked at <a href="https://www.fleetway.ca/en/"
          target="_blank" rel="noopener">Fleetway</a
        > on In-Service Support for the Canadian Navy's Halifax-class frigates. Before that, I led the team behind <a
          href="https://2026.uottahack.ca/"
          target="_blank"
          rel="noopener">uOttaHack</a
        >.
      </p>
      <p>
        I also <a href="/other/books">read</a> and <a href="/writing">write</a>.
      </p>

      <p>
        Please feel free to <button id="say-hi-btn" class="inline-copy-btn">copy</button> <span id="copy-rest-text" class="copy-rest-text">my email and say hi.</span>
      </p>
      <p>
        This page was last updated on August 16.
      </p>

      <div class="pt-3 pb-2">
        <HandwrittenSignoff />
      </div>
    </article>

    <style>
      .inline-copy-btn {
        display: inline;
        vertical-align: baseline;
        font: inherit;
        line-height: inherit;
        border: none;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .copy-rest-text {
        transition: opacity var(--duration-fast) var(--ease-out);
      }

      .copy-rest-text.struck {
        text-decoration: line-through;
        opacity: 0.5;
      }
    </style>

    <script>
      function initIndexPage() {
        const sayHiBtn = document.getElementById("say-hi-btn");
        const restText = document.getElementById("copy-rest-text");
        const email = "farooq.qureshi@outlook.com";

        if (sayHiBtn) {
          sayHiBtn.addEventListener("click", async (e) => {
            e.preventDefault();
            try {
              await navigator.clipboard.writeText(email);
            } catch (err) {
              console.error("Could not copy email:", err);
            }
            sayHiBtn.textContent = "copied";
            if (restText) restText.classList.add("struck");

            setTimeout(() => {
              sayHiBtn.textContent = "copy";
              if (restText) restText.classList.remove("struck");
            }, 2000);
          });
        }
      }

      document.addEventListener("astro:page-load", initIndexPage);
      initIndexPage();
    </script>
  </main>
</IndexLayout>
