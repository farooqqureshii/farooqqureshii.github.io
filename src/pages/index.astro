---
import { SITE_DESCRIPTION } from "../consts";
import IndexLayout from "../layouts/IndexLayout.astro";
---

<IndexLayout title="Farooq Q." description={SITE_DESCRIPTION}>
  <main class="index-page">
    <article class="index-content space-y-4 text-sm leading-relaxed">
      <p>
        I'm a third-year <a
          href="https://www.uoee.rocks/"
          target="_blank"
          rel="noopener">Electrical Engineering</a
        > student at <a href="https://uottawa.ca" target="_blank" rel="noopener"
          >the University of Ottawa</a
        >. This summer, I'm working at <a
          href="https://www.fleetway.ca/en/"
          target="_blank"
          rel="noopener">Fleetway</a
        > on the <a
          href="https://www.canada.ca/en/department-national-defence/services/procurement/halifax-class-modernization.html"
          target="_blank"
          rel="noopener">Halifax-class Modernization</a
        > effort.
      </p>
      <p>
        Before this, I led the team behind <a
          href="https://2026.uottahack.ca/"
          target="_blank"
          rel="noopener">uOttaHack</a
        >. Before that, I debated competitively internationally and now coach.
      </p>
      <p>
        I'm interested in power electronics and energy conversion systems.
        In particular, converter design and switching regulator
        topologies.
      </p>
      <p>
        I enjoy <a href="/other/books">reading</a> and <a href="/writing">writing</a>.
      </p>

      <p>
        Please feel free to <button id="say-hi-btn" class="inline-copy-btn">copy</button> <span id="copy-rest-text" class="copy-rest-text">my email and say hi.</span>
      </p>
      <p>
        This page was last updated on July 13. Thank you for stopping by.
      </p>
    </article>

    <style>
      .inline-copy-btn {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: #8a8a8e;
        text-underline-offset: 4px;
        background: transparent;
        border: none;
        padding: 0;
        font: inherit;
        cursor: pointer;
        transition: color var(--duration-base) var(--ease-out), text-decoration-color var(--duration-base) var(--ease-out);
        -webkit-tap-highlight-color: transparent;
      }

      html.dark .inline-copy-btn {
        text-decoration-color: #71717a;
      }

      html.blue .inline-copy-btn {
        text-decoration-color: rgba(255, 255, 255, 0.5);
      }

      html.pink .inline-copy-btn {
        text-decoration-color: #e094a4;
      }

      html.green .inline-copy-btn {
        text-decoration-color: #4a8553;
      }

      .inline-copy-btn:hover {
        color: #000000;
        text-decoration-color: #000000;
      }

      html.dark .inline-copy-btn:hover,
      html.blue .inline-copy-btn:hover {
        color: #ffffff;
        text-decoration-color: #ffffff;
      }

      html.pink .inline-copy-btn:hover {
        color: #000000;
        text-decoration-color: #000000;
      }

      html.green .inline-copy-btn:hover {
        color: #000000;
        text-decoration-color: #000000;
      }

      .copy-rest-text {
        transition: opacity var(--duration-fast) var(--ease-out);
      }

      .copy-rest-text.struck {
        text-decoration: line-through;
        opacity: 0.5;
      }
    </style>

    <script>
      function initIndexPage() {
        const sayHiBtn = document.getElementById("say-hi-btn");
        const restText = document.getElementById("copy-rest-text");
        const email = "farooq.qureshi@outlook.com";

        if (sayHiBtn) {
          sayHiBtn.addEventListener("click", async (e) => {
            e.preventDefault();
            try {
              await navigator.clipboard.writeText(email);
            } catch (err) {
              console.error("Could not copy email:", err);
            }
            sayHiBtn.textContent = "copied";
            if (restText) restText.classList.add("struck");

            setTimeout(() => {
              sayHiBtn.textContent = "copy";
              if (restText) restText.classList.remove("struck");
            }, 2000);
          });
        }
      }

      document.addEventListener("astro:page-load", initIndexPage);
    </script>
  </main>
</IndexLayout>
