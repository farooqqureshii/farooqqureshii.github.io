---
import { SITE_DESCRIPTION } from "../consts";
import IndexLayout from "../layouts/IndexLayout.astro";
---

<IndexLayout title="Farooq Q." description={SITE_DESCRIPTION}>
  <main class="index-page">
    <article class="index-content space-y-4 text-sm leading-relaxed">
      <p>
        I'm a third-year <a
          href="https://www.uoee.rocks/"
          target="_blank"
          rel="noopener">Electrical Engineering</a
        > student at <a href="https://uottawa.ca" target="_blank" rel="noopener"
          >the University of Ottawa</a
        >.
      </p>
      <p>
        This past summer, I worked at <a href="https://www.fleetway.ca/en/"
          target="_blank" rel="noopener">Fleetway</a
        > on In-Service Support for the Canadian Navy's Halifax-class frigates. Before that, I led the team behind <a
          href="https://2026.uottahack.ca/"
          target="_blank"
          rel="noopener">uOttaHack</a
        >.
      </p>
      <p>
        I'm interested in power electronics and energy conversion systems.
        In particular, converter design and switching regulator
        topologies.
      </p>
      <p>
        I also <a href="/other/books">read</a> and <a href="/writing">write</a>.
      </p>

      <p>
        Please feel free to <button id="say-hi-btn" class="inline-copy-btn">copy</button> <span id="copy-rest-text" class="copy-rest-text">my email and say hi.</span>
      </p>
      <p>
        This page was last updated on August 16. Thank you for stopping by.
      </p>
    </article>

    <style>
      .inline-copy-btn {
        color: inherit;
        display: inline;
        vertical-align: baseline;
        font: inherit;
        line-height: inherit;
        font-weight: inherit;
        text-decoration: underline !important;
        text-decoration-thickness: 2px !important;
        text-underline-offset: 3.5px !important;
        text-decoration-color: var(--link-line) !important;
        text-decoration-skip-ink: none;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
        border-radius: 0;
        border: none;
        cursor: pointer;
        transition: text-decoration-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out) !important;
        -webkit-tap-highlight-color: transparent;
      }

      @media (hover: hover) and (pointer: fine) {
        .inline-copy-btn:hover {
          color: var(--link-hover-color) !important;
          text-decoration-color: var(--link-line-hover) !important;
        }
      }

      .copy-rest-text {
        transition: opacity var(--duration-fast) var(--ease-out);
      }

      .copy-rest-text.struck {
        text-decoration: line-through;
        opacity: 0.5;
      }
    </style>

    <script>
      function initIndexPage() {
        const sayHiBtn = document.getElementById("say-hi-btn");
        const restText = document.getElementById("copy-rest-text");
        const email = "farooq.qureshi@outlook.com";

        if (sayHiBtn) {
          sayHiBtn.addEventListener("click", async (e) => {
            e.preventDefault();
            try {
              await navigator.clipboard.writeText(email);
            } catch (err) {
              console.error("Could not copy email:", err);
            }
            sayHiBtn.textContent = "copied";
            if (restText) restText.classList.add("struck");

            setTimeout(() => {
              sayHiBtn.textContent = "copy";
              if (restText) restText.classList.remove("struck");
            }, 2000);
          });
        }
      }

      document.addEventListener("astro:page-load", initIndexPage);
    </script>
  </main>
</IndexLayout>
