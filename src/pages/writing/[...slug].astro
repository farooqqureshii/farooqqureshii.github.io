---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatLongDate } from "../../lib/utils";

export const prerender = true;

export async function getStaticPaths() {
  const writing = await getCollection("writing");
  return writing.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;

if (!post) {
  throw new Error(`Post not found for slug: ${Astro.params.slug}`);
}

if (!post.data) {
  throw new Error(
    `Post data is undefined for slug: ${Astro.params.slug}. Post object: ${JSON.stringify(post, null, 2)}`,
  );
}

const { title, date, description } = post.data;
const { Content } = await post.render();


const allPosts = await getCollection("writing");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
---

<Layout title={`Farooq Q. | ${title}`} description={description}>
  <main>
    <h1 class="mb-1 text-sm font-medium">{title}</h1>
    <p class="mb-6 text-sm opacity-60">
      Published on {formatLongDate(date)}
    </p>
    <article class="text-sm leading-relaxed [&_p]:my-4">
      <Content />
    </article>

    <div
      class="mt-12 flex items-center justify-between text-sm opacity-70"
    >
      <a href="/writing" class="list-link">← All Writing</a>
      {
        nextPost && (
          <a href={`/writing/${nextPost.slug}`} class="list-link">
            Next: {nextPost.data.title} →
          </a>
        )
      }
    </div>
  </main>
</Layout>
