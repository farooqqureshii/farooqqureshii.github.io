---
const path = Astro.url.pathname;
---

<!-- Desktop Sidebar (Hidden on mobile) -->
<aside class="sidebar-col hidden md:flex flex-col gap-6 w-[150px] shrink-0">
  <!-- Title / Brand -->
  <div>
    <a href="/" class={`sidebar-brand ${path === '/' ? 'active' : ''}`}>Farooq Qureshi</a>
  </div>

  <!-- Primary Page Links & Theme Toggle -->
  <nav class="flex flex-col gap-y-1">
    <a
      href="/projects"
      class={`sidebar-link ${path.startsWith('/projects') ? 'active' : ''}`}
    >Projects</a>
    <a
      href="/writing"
      class={`sidebar-link ${path.startsWith('/writing') ? 'active' : ''}`}
    >Writing</a>
    <a
      href="/other"
      class={`sidebar-link ${path.startsWith('/other') || path.startsWith('/bookmarks') ? 'active' : ''}`}
    >Other</a>
    <button
      id="sidebar-theme-toggle"
      class="sidebar-link cursor-pointer select-none text-left theme-toggle-action"
      title="Toggle theme"
    >
      <span class="theme-label inline-block">Dark</span>
    </button>
  </nav>
</aside>

<!-- Mobile Header (Visible on mobile only: clean inline 2-row layout, zero hamburger) -->
<header class="mobile-header flex md:hidden flex-col gap-1.5 w-full mb-6 select-none">
  <div>
    <a href="/" class={`sidebar-brand ${path === '/' ? 'active' : ''}`}>Farooq Qureshi</a>
  </div>

  <nav class="flex items-center gap-3.5 text-[15px]" aria-label="Mobile Navigation">
    <a
      href="/projects"
      class={`sidebar-link ${path.startsWith('/projects') ? 'active' : ''}`}
    >Projects</a>
    <a
      href="/writing"
      class={`sidebar-link ${path.startsWith('/writing') ? 'active' : ''}`}
    >Writing</a>
    <a
      href="/other"
      class={`sidebar-link ${path.startsWith('/other') || path.startsWith('/bookmarks') ? 'active' : ''}`}
    >Other</a>
    <button
      id="mobile-theme-toggle"
      class="sidebar-link cursor-pointer select-none text-left theme-toggle-action"
      title="Toggle theme"
    >
      <span class="theme-label inline-block">Dark</span>
    </button>
  </nav>
</header>

<script>
  function initHeader() {
    // Theme toggle handlers (strictly Light / Dark)
    const themeLabels = document.querySelectorAll(".theme-label");
    const toggleButtons = document.querySelectorAll(".theme-toggle-action");

    function isDarkMode(): boolean {
      return document.documentElement.classList.contains("dark");
    }

    function updateThemeLabels() {
      const isDark = isDarkMode();
      themeLabels.forEach((lbl) => {
        lbl.textContent = isDark ? "Light" : "Dark";
      });
    }

    const toggleTheme = (e?: Event) => {
      if (e) e.preventDefault();
      const html = document.documentElement;
      const willBeDark = !html.classList.contains("dark");
      
      html.classList.remove("blue", "pink", "green");

      if (willBeDark) {
        html.classList.add("dark");
      } else {
        html.classList.remove("dark");
      }

      try {
        localStorage.setItem("theme", willBeDark ? "dark" : "light");
      } catch (err) {}

      updateThemeLabels();
    };

    toggleButtons.forEach((btn) => {
      (btn as HTMLElement).onclick = toggleTheme;
    });

    updateThemeLabels();
  }

  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
