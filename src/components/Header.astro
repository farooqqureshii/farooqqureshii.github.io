---
const path = Astro.url.pathname;
---

<!-- Desktop Sidebar (Hidden on mobile) -->
<aside class="sidebar-col hidden md:flex flex-col gap-6 w-[150px] shrink-0">
  <!-- Title / Brand -->
  <div>
    <a href="/" class={`sidebar-brand ${path === '/' ? 'active' : ''}`}>Farooq Qureshi</a>
  </div>

  <!-- Primary Page Links -->
  <nav class="flex flex-col gap-y-1">
    <a
      href="/projects"
      class={`sidebar-link ${path.startsWith('/projects') ? 'active' : ''}`}
    >Projects</a>
    <a
      href="/writing"
      class={`sidebar-link ${path.startsWith('/writing') ? 'active' : ''}`}
    >Writing</a>
    <a
      href="/bookmarks"
      class={`sidebar-link ${path.startsWith('/bookmarks') ? 'active' : ''}`}
    >Bookmarks</a>
    <a
      href="/other"
      class={`sidebar-link ${path.startsWith('/other') ? 'active' : ''}`}
    >Other</a>
  </nav>

  <!-- External / Contact Links -->
  <div class="flex flex-col gap-y-1">
    <button
      id="sidebar-copy-email"
      class="sidebar-link"
      title="Copy email to clipboard"
    >
      <span class="sidebar-email-label">Email</span>
    </button>
    <a
      href="https://github.com/farooqqureshii"
      target="_blank"
      rel="noopener"
      class="sidebar-link"
    >GitHub</a>
    <a
      href="https://linkedin.com/in/farooqq"
      target="_blank"
      rel="noopener"
      class="sidebar-link"
    >LinkedIn</a>
    <a
      href="https://www.cosmos.so/farooqqureshi"
      target="_blank"
      rel="noopener"
      class="sidebar-link"
    >Cosmos</a>
  </div>

  <!-- Theme Toggle (separated by same gap-6 as previous sections) -->
  <div class="flex flex-col gap-y-1">
    <button
      id="desktop-theme-toggle"
      class="sidebar-link cursor-pointer text-left select-none"
      aria-label="Toggle theme"
      title="Toggle theme"
    >
      <span class="theme-toggle-label">Dark</span>
    </button>
  </div>

  <!-- Back Button -->
  {path !== '/' && (
    <div>
      <button
        class="back-btn sidebar-link inline-flex items-center gap-1.5 cursor-pointer select-none"
        aria-label="Go back"
        title="Go back"
      >
        <svg class="w-3.5 h-3.5 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        <span>Back</span>
      </button>
    </div>
  )}
</aside>

<!-- Mobile Header (Visible on mobile only) -->
<div class="mobile-header relative flex md:hidden items-center justify-between w-full mb-8">
  <a id="mobile-brand-title" href="/" class={`sidebar-brand relative z-10 no-underline ${path === '/' ? 'active' : ''}`}>Farooq Qureshi</a>
  <div class="flex items-center gap-2 relative z-[60]">
    {path !== '/' && (
      <button
        id="mobile-back-btn"
        class="back-btn sidebar-link p-1 no-underline cursor-pointer select-none flex items-center justify-center min-w-[32px] min-h-[32px]"
        aria-label="Go back"
        title="Go back"
      >
        <svg class="w-5 h-5 stroke-current block" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
      </button>
    )}
    <button
      id="mobile-theme-toggle"
      class="sidebar-link p-1 no-underline cursor-pointer select-none flex items-center justify-center min-w-[32px] min-h-[32px]"
      aria-label="Toggle theme"
      title="Toggle theme"
    >
      <svg id="theme-sun-icon" class="w-5 h-5 stroke-current hidden" fill="none" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="5" stroke-width="1.75"></circle>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
      </svg>
      <svg id="theme-moon-icon" class="w-5 h-5 stroke-current block" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
    <button
      id="hamburger-btn"
      class="sidebar-link p-1 transition-opacity no-underline cursor-pointer select-none flex items-center justify-center min-w-[32px] min-h-[32px]"
      aria-label="Toggle menu"
    >
      <svg id="hamburger-icon" class="w-6 h-6 stroke-current block" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 stroke-current hidden" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<!-- Mobile Fullscreen Overlay: Left-aligned list without brand title -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-50 flex flex-col justify-center items-start px-6 sm:px-8 opacity-0 pointer-events-none transition-opacity duration-150 ease-out md:hidden will-change-[opacity]"
>
  <div class="flex flex-col text-left text-2xl sm:text-3xl font-normal leading-snug tracking-tight gap-2.5 no-underline w-full max-w-[780px] mx-auto">
    <a
      href="/projects"
      class={`mobile-nav-link no-underline ${path.startsWith('/projects') ? 'active' : ''}`}
    >Projects</a>
    <a
      href="/writing"
      class={`mobile-nav-link no-underline ${path.startsWith('/writing') ? 'active' : ''}`}
    >Writing</a>
    <a
      href="/bookmarks"
      class={`mobile-nav-link no-underline ${path.startsWith('/bookmarks') ? 'active' : ''}`}
    >Bookmarks</a>
    <a
      href="/other"
      class={`mobile-nav-link no-underline ${path.startsWith('/other') ? 'active' : ''}`}
    >Other</a>
    <a
      href="https://www.cosmos.so/farooqqureshi"
      target="_blank"
      rel="noopener"
      class="mobile-nav-link no-underline"
    >Cosmos</a>
    <a
      href="https://linkedin.com/in/farooqq"
      target="_blank"
      rel="noopener"
      class="mobile-nav-link no-underline"
    >LinkedIn</a>
    <a
      href="https://github.com/farooqqureshii"
      target="_blank"
      rel="noopener"
      class="mobile-nav-link no-underline"
    >GitHub</a>
    <button
      id="mobile-copy-email"
      class="mobile-nav-link no-underline text-left cursor-pointer"
    >
      <span class="mobile-email-label">Email</span>
    </button>
    <button
      id="overlay-theme-toggle"
      class="mobile-nav-link no-underline text-left cursor-pointer"
    >
      <span class="theme-toggle-label">Dark</span>
    </button>
  </div>
</div>

<script>
  function initHeader() {
    const overlay = document.getElementById("menu-overlay");
    const burgerBtn = document.getElementById("hamburger-btn");
    const burgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const brandTitle = document.getElementById("mobile-brand-title");
    const mobileBackBtn = document.getElementById("mobile-back-btn");

    // Theme toggles
    function updateThemeUI() {
      const isDark = document.documentElement.classList.contains("dark");
      const labels = document.querySelectorAll(".theme-toggle-label");
      labels.forEach((el) => {
        el.textContent = isDark ? "Light" : "Dark";
      });
      const sunIcon = document.getElementById("theme-sun-icon");
      const moonIcon = document.getElementById("theme-moon-icon");
      if (sunIcon && moonIcon) {
        if (isDark) {
          sunIcon.classList.remove("hidden");
          moonIcon.classList.add("hidden");
        } else {
          sunIcon.classList.add("hidden");
          moonIcon.classList.remove("hidden");
        }
      }
    }

    function toggleTheme(e?: Event) {
      if (e) e.preventDefault();
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (err) {}
      updateThemeUI();
    }

    const desktopThemeToggle = document.getElementById("desktop-theme-toggle");
    const mobileThemeToggle = document.getElementById("mobile-theme-toggle");
    const overlayThemeToggle = document.getElementById("overlay-theme-toggle");

    if (desktopThemeToggle) desktopThemeToggle.onclick = toggleTheme;
    if (mobileThemeToggle) mobileThemeToggle.onclick = toggleTheme;
    if (overlayThemeToggle) {
      overlayThemeToggle.onclick = (e) => {
        toggleTheme(e);
        closeMenu();
      };
    }

    updateThemeUI();

    if (!overlay || !burgerBtn) return;

    function openMenu() {
      if (!overlay) return;
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden";

      if (brandTitle) {
        brandTitle.classList.add("pointer-events-none");
      }
      if (mobileBackBtn) {
        mobileBackBtn.classList.add("hidden");
      }
      if (burgerIcon) burgerIcon.classList.add("hidden");
      if (closeIcon) closeIcon.classList.remove("hidden");
    }

    function closeMenu() {
      if (!overlay) return;
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";

      if (brandTitle) {
        brandTitle.classList.remove("pointer-events-none");
      }
      if (mobileBackBtn) {
        mobileBackBtn.classList.remove("hidden");
      }
      if (burgerIcon) burgerIcon.classList.remove("hidden");
      if (closeIcon) closeIcon.classList.add("hidden");
    }

    function toggleMenu(e?: Event) {
      if (e) e.stopPropagation();
      if (!overlay) return;
      if (burgerBtn) burgerBtn.blur();
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
      if (overlay.classList.contains("opacity-100")) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    burgerBtn.onclick = (e) => {
      toggleMenu(e);
      burgerBtn.blur();
    };

    const handleCustomToggle = (e: any) => {
      if (e.detail?.action === "open") openMenu();
      else if (e.detail?.action === "close") closeMenu();
      else toggleMenu();
    };

    document.removeEventListener("toggle-hamburger-menu", handleCustomToggle);
    document.addEventListener("toggle-hamburger-menu", handleCustomToggle);

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.classList.contains("opacity-100")) {
        closeMenu();
      }
    });

    // Close overlay when clicking any link inside overlay
    const overlayLinks = overlay.querySelectorAll("a");
    overlayLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Back button handlers
    const backButtons = document.querySelectorAll(".back-btn");
    backButtons.forEach((btn) => {
      (btn as HTMLElement).onclick = (e) => {
        e.preventDefault();
        if (window.history.length > 1 && document.referrer && new URL(document.referrer).origin === window.location.origin) {
          window.history.back();
        } else {
          const pathSegments = window.location.pathname.split("/").filter(Boolean);
          if (pathSegments.length > 1) {
            pathSegments.pop();
            window.location.href = "/" + pathSegments.join("/");
          } else {
            window.location.href = "/";
          }
        }
      };
    });

    // Email Copy handlers
    const sidebarEmailLabel = document.querySelector(".sidebar-email-label");
    const mobileEmailLabel = document.querySelector(".mobile-email-label");
    const desktopCopyBtn = document.getElementById("sidebar-copy-email");
    const mobileCopyBtn = document.getElementById("mobile-copy-email");

    if (desktopCopyBtn) {
      desktopCopyBtn.onclick = () => {
        navigator.clipboard.writeText("farooq.qureshi@outlook.com").then(() => {
          if (sidebarEmailLabel) sidebarEmailLabel.textContent = "Copied";
          setTimeout(() => {
            if (sidebarEmailLabel) sidebarEmailLabel.textContent = "Email";
          }, 2000);
        });
      };
    }

    if (mobileCopyBtn) {
      mobileCopyBtn.onclick = () => {
        navigator.clipboard.writeText("farooq.qureshi@outlook.com").then(() => {
          if (mobileEmailLabel) mobileEmailLabel.textContent = "Copied";
          setTimeout(() => {
            if (mobileEmailLabel) mobileEmailLabel.textContent = "Email";
          }, 2000);
        });
      };
    }
  }

  document.addEventListener("astro:after-swap", initHeader);
  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
