---
// Footer with Ottawa time and weather condition
---

<footer class="relative select-none">
  <p class="footer-text text-[15px] leading-[1.65] relative z-10 m-0">
    It's <span id="ottawa-time" class="inline-block tabular-nums" style="min-width:5.5ch;">--:--:--</span> and <span id="ottawa-weather">sunny</span> in Ottawa, Ontario.
  </p>
</footer>

<style>
  footer {
    position: relative;
    display: flex;
    align-items: center;
    padding: 12px 0;
    margin-top: 24px;
    width: 100%;
  }

  .footer-text {
    color: inherit;
    font-size: 15px;
    line-height: 1.65;
    font-weight: inherit;
    opacity: 0.6;
  }
</style>

<script>
  const OTTAWA = { lat: 45.4215, lon: -75.6972 };
  const WEATHER_URL = `https://api.open-meteo.com/v1/forecast?latitude=${OTTAWA.lat}&longitude=${OTTAWA.lon}&current=weather_code,is_day&timezone=America%2FToronto`;

  function getWeatherCondition(code: number, isDay: number = 1): string {
    switch (code) {
      case 0:
        return isDay ? "sunny" : "clear";
      case 1:
        return isDay ? "mostly sunny" : "mostly clear";
      case 2:
        return "partly cloudy";
      case 3:
        return "cloudy";
      case 45:
      case 48:
        return "foggy";
      case 51:
      case 53:
      case 55:
      case 56:
      case 57:
        return "drizzling";
      case 61:
      case 63:
      case 65:
      case 66:
      case 67:
      case 80:
      case 81:
      case 82:
        return "rainy";
      case 71:
      case 73:
      case 75:
      case 77:
      case 85:
      case 86:
        return "snowy";
      case 95:
      case 96:
      case 99:
        return "thunderstormy";
      default:
        return isDay ? "sunny" : "clear";
    }
  }

  function updateTime() {
    const t = new Date().toLocaleTimeString("en-CA", {
      timeZone: "America/Toronto",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });
    const el = document.getElementById("ottawa-time");
    if (el) el.textContent = t;
  }

  async function updateWeather() {
    const el = document.getElementById("ottawa-weather");
    if (!el) return;

    const cachedCond = localStorage.getItem("ottawa_cond");
    const cachedTime = localStorage.getItem("ottawa_cond_time");
    const CACHE_DURATION = 15 * 60 * 1000;

    if (cachedCond && cachedTime) {
      const age = Date.now() - parseInt(cachedTime, 10);
      if (age < CACHE_DURATION) {
        el.textContent = cachedCond;
        return;
      } else {
        el.textContent = cachedCond;
      }
    }

    try {
      const res = await fetch(WEATHER_URL);
      if (!res.ok) throw new Error();
      const data = await res.json();
      const code = data.current.weather_code ?? 0;
      const isDay = data.current.is_day ?? 1;
      const cond = getWeatherCondition(code, isDay);
      el.textContent = cond;

      localStorage.setItem("ottawa_cond", cond);
      localStorage.setItem("ottawa_cond_time", Date.now().toString());
    } catch {
      if (!el.textContent || el.textContent === "--°C") {
        el.textContent = "clear";
      }
    }
  }

  function init() {
    updateTime();
    updateWeather();

    if (!(window as any).__footer_intervals_setup__) {
      (window as any).__footer_intervals_setup__ = true;
      setInterval(updateTime, 1000);
      setInterval(updateWeather, 15 * 60 * 1000);
    }
  }

  document.addEventListener("astro:page-load", init);
  init();
</script>
