    <!-- WORD 2: "you" (Continuous fluid sloppy flow) -->
    <path class="hw-stroke" data-order="4" data-speed="0.9" d="M 108.5 23.5 C 110.5 26.5, 113 29.5, 114.8 31 C 116.8 27.5, 119.5 23.5, 122 21 C 120.5 28.5, 118 38, 115.5 44 C 113.8 49, 110 50.5, 107.5 47.5 C 105 44.5, 109.5 38.5, 115 32 C 118 28.5, 122 25.5, 126 26.5 C 128 27, 133 22, 128.5 21.5 C 124 23, 124.5 28.5, 126.5 31.5 C 129 35, 134.5 34, 135.5 28 C 136 24, 133 22.5, 131 23 C 134 23.5, 138 25.5, 140 27.5 C 142 29.5, 143 24, 143.5 23 C 144 27.5, 143 31.5, 147 32.5 C 150 33, 152 28.5, 153 23 C 153.2 27, 152.5 31, 154 32.8 C 156 34.5, 159 32, 162 29" />

    <!-- WORD 3: "for" (Continuous flowing loops) -->
    <!-- f: tall ascender + deep descender + loop into o and r -->
    <path class="hw-stroke" data-order="5" data-speed="0.95" d="M 167 30 C 170.5 25.5, 175 13, 176.8 8 C 178 5, 175.5 9, 173.5 19 C 170.8 31.5, 167.5 45.5, 165.5 48.5 C 164 50.5, 167 43, 171.5 33 C 174.5 26, 178.5 24, 181.5 26.5 C 184 28.5, 188 22.5, 184.5 21.5 C 180.5 23, 180.5 28, 182 31.5 C 184 35, 189.5 34, 191 28.5 C 192 24, 188.5 22.5, 186.5 23 C 189.5 23.5, 193.5 25.5, 195.5 27.5 C 197.5 29.5, 198 24.5, 198.2 23 C 198.5 27, 197.8 31, 198 33 C 198.8 28.5, 201 23, 204.5 22.5 C 207 22, 208.5 24, 209.8 26 C 211 28, 212 32, 214.5 31" />
