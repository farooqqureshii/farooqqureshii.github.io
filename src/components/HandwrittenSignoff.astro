---
// HandwrittenSignoff.astro - Ultra-realistic, human handwriting animation with multi-stroke breakdown & natural pen dynamics
---

<div class="handwriting-wrapper select-none group" id="hw-signoff-wrapper" title="Click to replay handwriting">
  <svg
    id="hw-svg"
    viewBox="0 0 440 68"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="handwriting-svg"
    aria-label="Thank you for stopping by. — Farooq"
  >
    <!-- ==================== "Thank you for stopping by." ==================== -->

    <!-- WORD 1: "Thank" -->
    <!-- T: 1. Top bar with slight slant & hook -->
    <path class="hw-stroke" data-order="1" data-speed="1.0" d="M 12 14 C 17 11.5, 26 10, 35 12 C 37 12.5, 38 11.5, 36 13" />
    <!-- T: 2. Downward stem with slight cursive curve & bottom hook -->
    <path class="hw-stroke" data-order="2" data-speed="1.1" d="M 23 12 C 21.5 19, 19.5 27, 17.5 33 C 16.5 35.5, 18.5 36, 21.5 34.5" />
    <!-- h: 3. Ascender loop & downstroke -->
    <path class="hw-stroke" data-order="3" data-speed="1.2" d="M 28 34 C 31 31, 36 17, 39 10 C 40 7.5, 38 11, 37 18 C 36 26, 36.5 32, 38 33.5" />
    <!-- h: 4. Arch and exit branch -->
    <path class="hw-stroke" data-order="4" data-speed="0.9" d="M 37.5 24 C 40 21.5, 43.5 20.5, 45 25 C 46 28, 46.5 32, 49 33 C 51 34, 52 33, 53.5 31" />
    <!-- a: 5. Teardrop bowl counter-clockwise -->
    <path class="hw-stroke" data-order="5" data-speed="1.0" d="M 59 23 C 55 21, 50 25, 51.5 30 C 53 34, 58 33.5, 59 28" />
    <!-- a: 6. Right downward stem and exit flick -->
    <path class="hw-stroke" data-order="6" data-speed="0.9" d="M 59 24 C 59.2 28, 59 32, 60.5 33.5 C 62 34.5, 63.5 33, 65 30" />
    <!-- n: 7. Left downstroke -->
    <path class="hw-stroke" data-order="7" data-speed="0.8" d="M 67 23.5 C 67.5 27, 67 31, 67.2 33.5" />
    <!-- n: 8. Arch and downstroke with upward flick -->
    <path class="hw-stroke" data-order="8" data-speed="1.0" d="M 67.5 25 C 70 21.5, 73.5 21, 74.5 25.5 C 75.5 29, 76 32, 78 33.5 C 79.5 34.5, 81 33, 82.5 30" />
    <!-- k: 9. Tall ascender downstroke -->
    <path class="hw-stroke" data-order="9" data-speed="1.1" d="M 87 9 C 87.5 16, 86 26, 86.5 33.5" />
    <!-- k: 10. Upper diagonal in-loop and lower leg kick -->
    <path class="hw-stroke" data-order="10" data-speed="1.0" d="M 94 22 C 91 24.5, 88 26.5, 87 27 C 89 28, 93 31.5, 96 33.5 C 97.5 34.5, 99 33.5, 101 31" />

    <!-- WORD 2: "you" -->
    <!-- y: 11. Initial slant cup -->
    <path class="hw-stroke" data-order="11" data-speed="0.9" d="M 109 23 C 111 26, 113.5 29, 115 31 C 117 28, 119.5 24, 122 21.5" />
    <!-- y: 12. Long descender loop swinging up -->
    <path class="hw-stroke" data-order="12" data-speed="1.3" d="M 121.5 22 C 120 29, 117.5 38, 115.5 44 C 114 49, 110.5 50.5, 108 47.5 C 106 44.5, 111 38, 116 32 C 119 28, 123 26, 126 27" />
    <!-- o: 13. Oval loop with top tie -->
    <path class="hw-stroke" data-order="13" data-speed="1.1" d="M 134 23 C 129 21.5, 125 25.5, 126.5 30.5 C 128 34.5, 134 34, 135.5 28 C 136.5 24.5, 134 22.5, 132 23 C 135 23.5, 138 25, 140 27" />
    <!-- u: 14. First downcurve cup -->
    <path class="hw-stroke" data-order="14" data-speed="0.9" d="M 143 23 C 143.5 27, 143 31, 147 32 C 150 32.5, 152 28, 153 23" />
    <!-- u: 15. Right stem and exit ligature -->
    <path class="hw-stroke" data-order="15" data-speed="0.9" d="M 153 23 C 153 27, 152.5 31, 154 32.5 C 156 34, 159 32, 162 29" />

    <!-- WORD 3: "for" -->
    <!-- f: 16. Tall looped ascender dropping down to descender -->
    <path class="hw-stroke" data-order="16" data-speed="1.4" d="M 168 30 C 171 26, 175 13, 177 8 C 178.5 5, 176 9, 174 19 C 171.5 31, 168 45, 166 48 C 164.5 50, 168 42, 172 32 C 175 25.5, 179 24, 182 26" />
    <!-- f: 17. Quick crossbar tick -->
    <path class="hw-stroke" data-order="17" data-speed="0.7" d="M 167 22 C 171 21.5, 175 21, 178 20.5" />
    <!-- o: 18. Quick oval -->
    <path class="hw-stroke" data-order="18" data-speed="1.0" d="M 189 23 C 184.5 21.5, 180.5 25.5, 182 30.5 C 183.5 34.5, 189.5 34, 191 28.5 C 192 24.5, 189 22.5, 186.5 23 C 189.5 23.5, 193 25.5, 195 27" />
    <!-- r: 19. Stem, shoulder and downward leg -->
    <path class="hw-stroke" data-order="19" data-speed="1.0" d="M 198 23 C 198.5 26.5, 198 30.5, 198.2 33 C 198.5 28, 200 23, 203.5 22.5 C 206 22, 207.5 23.5, 209 25.5 C 210.5 27.5, 212 32, 214 31" />

    <!-- WORD 4: "stopping" -->
    <!-- s: 20. S curve stroke -->
    <path class="hw-stroke" data-order="20" data-speed="1.1" d="M 223 23 C 220 21.5, 215.5 22, 216 25.5 C 216.5 28, 222 28, 222.5 31 C 223 34, 218 35, 215.5 33.5" />
    <!-- t: 21. Downward stem with curve -->
    <path class="hw-stroke" data-order="21" data-speed="1.0" d="M 228 13 C 228.5 20, 227.5 28, 228 32 C 228.5 33.5, 230.5 34, 233 32" />
    <!-- o: 22. Oval loop -->
    <path class="hw-stroke" data-order="22" data-speed="1.0" d="M 241 23 C 237 21.5, 233 25.5, 234.5 30.5 C 236 34.5, 241.5 34, 243 28.5 C 244 24.5, 241 22.5, 238.5 23 C 241.5 24, 244 26, 246 28" />
    <!-- p1: 23. First p downstem into descender -->
    <path class="hw-stroke" data-order="23" data-speed="1.1" d="M 249 23 C 249.5 29, 248 37, 247 43" />
    <!-- p1: 24. First p bowl -->
    <path class="hw-stroke" data-order="24" data-speed="0.9" d="M 248 24 C 251.5 21.5, 256.5 22.5, 256.8 27 C 257 31.5, 252 33, 248.5 32.5 C 250.5 32, 253 30, 255 28" />
    <!-- p2: 25. Second p downstem into descender -->
    <path class="hw-stroke" data-order="25" data-speed="1.1" d="M 259 23 C 259.5 29, 258 37, 257 43" />
    <!-- p2: 26. Second p bowl -->
    <path class="hw-stroke" data-order="26" data-speed="0.9" d="M 258 24 C 261.5 21.5, 266.5 22.5, 266.8 27 C 267 31.5, 262 33, 258.5 32.5 C 260.5 32, 264 29, 267 27" />
    <!-- i: 27. Short stem with exit flick -->
    <path class="hw-stroke" data-order="27" data-speed="0.8" d="M 271 23 C 271.5 26.5, 271 30, 271.5 32.5 C 272 34, 274 33, 276 30" />
    <!-- n: 28. Left downstroke -->
    <path class="hw-stroke" data-order="28" data-speed="0.8" d="M 279 23.5 C 279.5 27, 279 30.5, 279.2 33" />
    <!-- n: 29. Arch and downstroke with flick -->
    <path class="hw-stroke" data-order="29" data-speed="1.0" d="M 279.5 25 C 282 21.5, 285.5 21, 286.5 25.5 C 287.5 29, 288 32, 290 33 C 291.5 34, 293 32, 295 29" />
    <!-- g: 30. Round bowl -->
    <path class="hw-stroke" data-order="30" data-speed="1.0" d="M 304 23 C 300 21.5, 295.5 25, 296.5 29.5 C 297.5 33.5, 302.5 33.5, 304 28" />
    <!-- g: 31. Descender loop sweeping up -->
    <path class="hw-stroke" data-order="31" data-speed="1.3" d="M 304 23 C 304.5 28, 303.5 36, 301.5 42 C 299.5 47, 295.5 49, 293 46 C 291 43, 297 37, 303 32 C 307 28.5, 312 27, 315 29" />
    <!-- t crossbar (drawn after the word body is finished) -->
    <path class="hw-stroke" data-order="32" data-speed="0.6" d="M 223 18.5 C 227 18, 231 17.5, 235 17" />
    <!-- i dot (tapped after the word body is finished) -->
    <path class="hw-stroke" data-order="33" data-speed="0.4" d="M 271.5 15.5 C 271.8 15, 272.2 15.5, 271.9 16" />

    <!-- WORD 5: "by." -->
    <!-- b: 34. Tall ascender downstroke -->
    <path class="hw-stroke" data-order="34" data-speed="1.1" d="M 324 8 C 324.5 16, 323 26, 323.5 33" />
    <!-- b: 35. Belly loop -->
    <path class="hw-stroke" data-order="35" data-speed="0.9" d="M 324 26 C 326.5 22, 332 21.5, 333 26.5 C 334 31, 329 33.5, 324.5 32.5 C 327 32, 330 29, 333 27" />
    <!-- y: 36. Slant cup -->
    <path class="hw-stroke" data-order="36" data-speed="0.9" d="M 338 23 C 340 26, 342.5 29, 344 31 C 346 28, 348.5 24, 351 21.5" />
    <!-- y: 37. Descender loop with flick -->
    <path class="hw-stroke" data-order="37" data-speed="1.2" d="M 350.5 22 C 349 29, 346.5 38, 344.5 44 C 343 48.5, 339.5 50, 337 47 C 335 44, 340 38, 346 32.5 C 350 28.5, 354 27.5, 358 29.5" />
    <!-- Period "." (pen tap) -->
    <path class="hw-stroke" data-order="38" data-speed="0.4" d="M 364 30 C 364.3 29.5, 364.8 30, 364.4 30.5" />

    <!-- ==================== PERSONAL SIGNATURE: "— Farooq" ==================== -->

    <!-- Dash "—" -->
    <path class="hw-stroke" data-order="39" data-speed="0.8" d="M 242 55 C 248 54.5, 255 55, 260 54" />

    <!-- F: 40. Main vertical stem with base curve -->
    <path class="hw-stroke" data-order="40" data-speed="1.1" d="M 275 42 C 273 41, 268 44, 269 50 C 270 58, 268 64, 266 67 C 265 68.5, 268 66, 270 61" />
    <!-- F: 41. Top cap flourish -->
    <path class="hw-stroke" data-order="41" data-speed="0.8" d="M 264 43.5 C 270 41.5, 277 42, 283 41" />
    <!-- F: 42. Middle cross stroke -->
    <path class="hw-stroke" data-order="42" data-speed="0.7" d="M 266 52.5 C 271 52, 277 51.5, 281 51" />

    <!-- a: 43. Bowl & stem -->
    <path class="hw-stroke" data-order="43" data-speed="1.0" d="M 288 53 C 285 51, 282 54, 283.5 57 C 284.5 60, 288 60, 289 57 C 289.5 54, 289 52, 289 58" />
    <!-- r: 44. Stem and shoulder -->
    <path class="hw-stroke" data-order="44" data-speed="0.9" d="M 290 55 C 291.5 52, 294 51.5, 296 51 C 297 52.5, 297.5 56, 298 57" />
    <!-- o1: 45. First o -->
    <path class="hw-stroke" data-order="45" data-speed="0.9" d="M 303 52 C 299 51, 299.5 57, 303 58 C 304.5 58, 305 55, 305 53" />
    <!-- o2: 46. Second o -->
    <path class="hw-stroke" data-order="46" data-speed="0.9" d="M 309 52 C 305 51, 305.5 57, 309 58 C 310.5 58, 311 55, 311 53" />
    <!-- q & Underline flourish: 47. Bowl, descender, and sweeping signature underline -->
    <path
      class="hw-stroke"
      data-order="47"
      data-speed="1.4"
      d="M 319 52 C 315 51, 313.5 55, 315 58 C 316.5 60, 319 59, 320 55 C 320.5 52, 320 50, 320 58 C 320 64, 318 69, 315 71 C 313 72, 315 69, 320 66 C 328 62, 345 57, 368 53 C 385 50, 405 48, 420 47"
    />
  </svg>
</div>

<style>
  .handwriting-wrapper {
    display: inline-block;
    width: 100%;
    max-width: 360px;
    cursor: pointer;
    margin-top: 0.25rem;
  }

  .handwriting-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .hw-stroke {
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0;
  }

  @media (max-width: 480px) {
    .handwriting-wrapper {
      max-width: 320px;
    }
    .hw-stroke {
      stroke-width: 1.45;
    }
  }
</style>

<script>
  function setupHandwritingAnimation() {
    const svg = document.getElementById("hw-svg");
    const container = document.getElementById("hw-signoff-wrapper");
    if (!svg || !container) return;

    const strokes = Array.from(svg.querySelectorAll<SVGPathElement>(".hw-stroke"));
    
    // Sort strokes strictly by data-order
    strokes.sort((a, b) => {
      const orderA = parseInt(a.getAttribute("data-order") || "0", 10);
      const orderB = parseInt(b.getAttribute("data-order") || "0", 10);
      return orderA - orderB;
    });

    // Compute stroke lengths and prepare dash offsets
    const strokeData = strokes.map((path) => {
      const length = path.getTotalLength() || 12;
      const speedMultiplier = parseFloat(path.getAttribute("data-speed") || "1.0");
      path.style.strokeDasharray = `${length} ${length + 3}`;
      path.style.strokeDashoffset = `${length}`;
      path.style.opacity = "0";
      return { path, length, speedMultiplier };
    });

    let isAnimating = false;

    async function playWriting() {
      if (isAnimating) return;
      isAnimating = true;

      // Reset all strokes instantly
      strokeData.forEach(({ path, length }) => {
        path.style.transition = "none";
        path.style.strokeDashoffset = `${length}`;
        path.style.opacity = "0";
      });

      // Allow DOM to apply resets
      await new Promise((r) => requestAnimationFrame(r));

      // Ultra-realistic human writing pace (~3.8s total) with human rhythm and pauses
      for (let i = 0; i < strokeData.length; i++) {
        const { path, length, speedMultiplier } = strokeData[i];
        const isDotOrTap = length < 8;
        const isFlourish = length > 80;
        
        // Human pen speed calculation (slower and more deliberate)
        let baseDuration: number;
        if (isDotOrTap) {
          baseDuration = 100;
        } else if (isFlourish) {
          baseDuration = Math.min(length * 3.5 * speedMultiplier, 600);
        } else {
          baseDuration = Math.max(130, Math.min(length * 5.2 * speedMultiplier, 420));
        }

        path.style.opacity = "1";
        // Human easing: gradual acceleration with gentle deceleration
        path.style.transition = `stroke-dashoffset ${baseDuration}ms cubic-bezier(0.42, 0, 0.25, 1)`;
        path.style.strokeDashoffset = "0";

        // Natural pen-lift pause before next stroke
        let pause: number;
        if (isDotOrTap) {
          pause = 80;
        } else if (i === 37) {
          // Pause after sentence finishes before starting signature
          pause = 320;
        } else if (i === 38) {
          // Pause after dash before signing name
          pause = 160;
        } else if (i === 31 || i === 32) {
          // Micro pause before crossing t or dotting i
          pause = 90;
        } else {
          pause = Math.max(35, baseDuration * 0.76);
        }

        await new Promise((r) => setTimeout(r, pause));
      }

      isAnimating = false;
    }

    // Trigger on viewport entrance
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            playWriting();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(container);

    // Replay on click
    container.addEventListener("click", () => {
      playWriting();
    });
  }

  document.addEventListener("astro:page-load", setupHandwritingAnimation);
  setupHandwritingAnimation();
</script>
