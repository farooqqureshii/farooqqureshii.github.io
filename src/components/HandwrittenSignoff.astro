    <path class="hw-stroke" data-order="8" data-speed="1.3" d="M 222 18.5 C 226.5 17.8, 231 17.2, 235 16.8" />
    <!-- i dot (relaxed casual pen tap) -->
    <path class="hw-stroke" data-order="9" data-speed="1.4" d="M 271 15.2 C 271.4 14.8, 272 15.2, 271.5 16" />

    <!-- WORD 5: "by." -->
    <!-- b-y: continuous fluid flow -->
    <path class="hw-stroke" data-order="10" data-speed="0.95" d="M 323.5 8 C 324.2 15.5, 322.8 25.5, 323.2 32.8 C 323.8 27.5, 327.5 22, 332 23 C 334.5 24, 334.8 28.5, 333 31.5 C 330.5 34.5, 325 33.5, 324 31 C 327 30, 331 27, 334 25.5 C 336.5 24.5, 337.8 27.5, 338.5 30 C 340.5 31.5, 344 28, 346.5 24 C 348.5 21, 350.5 21.5, 350 23.5 C 348.5 30, 346 38.5, 343.8 44.5 C 342 49, 338.5 50.5, 336 47.5 C 333.8 44.5, 339 38, 345 32.5 C 349.5 28.5, 354 27.5, 358 29.5" />
    <!-- Period "." (organic pen tap) -->
    <path class="hw-stroke" data-order="11" data-speed="1.4" d="M 363.8 30 C 364.2 29.5, 364.8 30, 364.2 30.8" />

    <!-- ==================== SMILEY FACE: ":)" ==================== -->
    <!-- Eye 1: Top eye casual flick -->
    <path class="hw-stroke" data-order="12" data-speed="1.3" d="M 374.2 15.2 C 374.8 14.5, 375.5 15, 375 16.2" />
    <!-- Eye 2: Bottom eye casual flick -->
    <path class="hw-stroke" data-order="13" data-speed="1.3" d="M 374.2 23.2 C 374.8 22.5, 375.5 23, 375 24.2" />
    <!-- Smile: Lively, expressive curved smile arc -->
    <path class="hw-stroke" data-order="14" data-speed="1.0" d="M 380.5 11.5 C 388.5 17, 389 31, 381.5 38" />
  </svg>
</div>

<style>
  .handwriting-wrapper {
    display: inline-block;
    width: 100%;
    max-width: 375px;
    cursor: pointer;
    margin-top: 0.25rem;
  }

  .handwriting-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .hw-stroke {
    stroke: currentColor;
    stroke-width: 1.45;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0;
  }

  @media (max-width: 480px) {
    .handwriting-wrapper {
      max-width: 335px;
    }
    .hw-stroke {
      stroke-width: 1.5;
    }
  }
</style>

<script>
  function setupHandwritingAnimation() {
    const svg = document.getElementById("hw-svg");
    const container = document.getElementById("hw-signoff-wrapper");
    if (!svg || !container) return;

    const strokes = Array.from(svg.querySelectorAll<SVGPathElement>(".hw-stroke"));
    
    // Sort strokes strictly by data-order
    strokes.sort((a, b) => {
      const orderA = parseInt(a.getAttribute("data-order") || "0", 10);
      const orderB = parseInt(b.getAttribute("data-order") || "0", 10);
      return orderA - orderB;
    });

    // Compute stroke lengths and prepare dash offsets
    const strokeData = strokes.map((path) => {
      const length = path.getTotalLength() || 10;
      const speedMultiplier = parseFloat(path.getAttribute("data-speed") || "1.0");
      path.style.strokeDasharray = `${length} ${length + 4}`;
      path.style.strokeDashoffset = `${length}`;
      path.style.opacity = "0";
      return { path, length, speedMultiplier };
    });

    let isAnimating = false;

    async function playWriting() {
      if (isAnimating) return;
      isAnimating = true;

      // Reset all strokes instantly
      strokeData.forEach(({ path, length }) => {
        path.style.transition = "none";
        path.style.strokeDashoffset = `${length}`;
        path.style.opacity = "0";
      });

      // Allow DOM to apply resets
      await new Promise((r) => requestAnimationFrame(r));

      // Silky-smooth, calm human writing flow with smooth continuous pacing
      for (let i = 0; i < strokeData.length; i++) {
        const { path, length, speedMultiplier } = strokeData[i];
        const isDotOrTap = length < 10;
        const isSmileyArc = i === strokeData.length - 1;
        
        // Gentle, consistent ink velocity (smooth and unhurried)
        let duration: number;
        if (isDotOrTap) {
          duration = 90;
        } else if (isSmileyArc) {
          duration = Math.max(240, length * 5.2);
        } else {
          duration = Math.max(180, length * 4.4 * speedMultiplier);
        }

        path.style.opacity = "1";
        // Smooth, fluid curve without aggressive sudden acceleration or jerky stops
        path.style.transition = `stroke-dashoffset ${duration}ms cubic-bezier(0.25, 0.1, 0.25, 1)`;
        path.style.strokeDashoffset = "0";

        // Clean, jitter-free progression: wait for current stroke to complete gracefully
        let gap: number;
        if (isDotOrTap) {
          gap = 50;
        } else if (i === strokeData.length - 4) {
          // Gentle breath after period before smiley face
          gap = 140;
        } else if (i === strokeData.length - 2) {
          // Breath before drawing smile arc
          gap = 70;
        } else if (i === 1 || i === 5 || i === 7) {
          // Immediate smooth continuation within the word
          gap = 15;
        } else {
          // Calm, natural pen lift between separate words
          gap = 60;
        }

        await new Promise((r) => setTimeout(r, duration + gap));
      }

      isAnimating = false;
    }

    // Trigger on viewport entrance
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            playWriting();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(container);

    // Replay on click
    container.addEventListener("click", () => {
      playWriting();
    });
  }

  document.addEventListener("astro:page-load", setupHandwritingAnimation);
  setupHandwritingAnimation();
</script>
