    <!-- WORD 4: "stopping" -->
    <!-- s-t-o-p-p-i-n-g: Continuous connected cursive body -->
    <path class="hw-stroke" data-order="7" data-speed="0.92" d="M 221.5 23 C 219 21.5, 214.5 22, 215.2 25.5 C 215.8 28, 221.2 28.5, 221.8 31.2 C 222.2 34, 217 35.5, 214.5 33.5 C 216 32, 222 24, 225 18 C 227 14, 227.8 19, 227.5 27 C 227.2 32, 229 33.5, 231.5 32 C 234 30.5, 237 24, 239.5 22.5 C 236 21, 232.5 24.8, 234 29.8 C 235.5 34.2, 241 34, 242.8 28.5 C 243.8 24, 240.5 22.5, 238.5 23 C 241.5 24, 245 26.5, 247.5 28.5 C 248.8 29.5, 249.2 24.5, 249 23 C 249.5 29, 248 37.5, 246.8 43.5 C 247.5 39, 250 25, 254.5 23 C 257.5 22.5, 258 26.5, 257.5 30 C 256.5 33.5, 251.5 33.5, 248.5 32.5 C 251.5 31.5, 255.5 27, 258.5 24 C 259 29.5, 257.8 37.5, 256.5 43.5 C 257.5 38.5, 260 25, 264.5 23 C 267.5 22.5, 268 26.5, 267.5 30 C 266.5 33.5, 261.5 33.5, 258.5 32.5 C 261 31.5, 266 28, 269 25 C 270.5 23.5, 271 27, 271.2 30.5 C 271.5 33.5, 273.5 33.5, 276 30.5 C 278 28, 278.8 24.5, 279 23.5 C 279.5 27.5, 278.8 31, 279 33 C 280 34.5, 282 25, 285.5 22 C 287.5 20.5, 288.5 25, 289 29.5 C 289.5 33, 291.5 34, 294 31 C 296.5 27.5, 300 23, 302 22 C 298.5 21, 294.5 24.5, 295.5 29 C 296.5 33.5, 302 33.5, 303.5 28 C 304 24, 303.5 32, 301.8 39 C 299.5 45.5, 295.5 48.5, 292.5 45.5 C 289.8 42.5, 296 36.5, 302 32 C 306.5 28.5, 311.5 27, 315 29.5" />
