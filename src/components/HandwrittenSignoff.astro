---
// HandwrittenSignoff.astro - Natural, casually messy cursive handwriting with a larger slanted smiley face
---

<div class="handwriting-wrapper select-none group" id="hw-signoff-wrapper" title="Click to replay handwriting">
  <svg
    id="hw-svg"
    viewBox="0 0 410 52"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="handwriting-svg"
    aria-label="Thank you for stopping by. :)"
  >
    <!-- ==================== "Thank you for stopping by. :)" ==================== -->

    <!-- WORD 1: "Thank" (Casual messy cursive flow) -->
    <!-- T: 1. Top bar with slight organic wave & slant -->
    <path class="hw-stroke" data-order="1" data-speed="1.0" d="M 11 13.5 C 16 11, 25 9.5, 34 11.5 C 36 12, 37 11, 35 12.5" />
    <!-- T: 2. Downward stem with relaxed cursive curve & bottom hook -->
    <path class="hw-stroke" data-order="2" data-speed="1.1" d="M 22.5 11.5 C 21 19, 18.5 27, 16.5 33 C 15.5 35.5, 17.5 36.5, 21 34.5" />
    <!-- h: 3. Ascender loop & downstroke -->
    <path class="hw-stroke" data-order="3" data-speed="1.2" d="M 27 34 C 30 31, 35 17, 38 9.5 C 39 7, 37.5 10.5, 36.5 17.5 C 35.5 25.5, 36 32, 37.5 33.5" />
    <!-- h: 4. Arch and exit branch -->
    <path class="hw-stroke" data-order="4" data-speed="0.9" d="M 37 23.5 C 39.5 21, 43 20, 44.5 24.5 C 45.5 27.5, 46 31.5, 48.5 33 C 50.5 34, 51.5 33, 53 31" />
    <!-- a: 5. Teardrop bowl counter-clockwise -->
    <path class="hw-stroke" data-order="5" data-speed="1.0" d="M 58.5 23 C 54.5 20.5, 49.5 24.5, 51 29.5 C 52.5 34, 57.5 33.5, 58.5 28" />
    <!-- a: 6. Right downward stem and exit flick -->
    <path class="hw-stroke" data-order="6" data-speed="0.9" d="M 58.5 24 C 58.7 28, 58.5 32, 60 33.5 C 61.5 34.5, 63 33, 64.5 30" />
    <!-- n: 7. Left downstroke -->
    <path class="hw-stroke" data-order="7" data-speed="0.8" d="M 66.5 23.5 C 67 27, 66.5 31, 66.8 33.5" />
    <!-- n: 8. Arch and downstroke with upward flick -->
    <path class="hw-stroke" data-order="8" data-speed="1.0" d="M 67 25 C 69.5 21.5, 73 21, 74 25.5 C 75 29, 75.5 32, 77.5 33.5 C 79 34.5, 80.5 33, 82 30" />
    <!-- k: 9. Tall ascender downstroke -->
    <path class="hw-stroke" data-order="9" data-speed="1.1" d="M 86.5 9 C 87 16, 85.5 26, 86 33.5" />
    <!-- k: 10. Upper diagonal in-loop and lower leg kick -->
    <path class="hw-stroke" data-order="10" data-speed="1.0" d="M 93.5 22 C 90.5 24.5, 87.5 26.5, 86.5 27 C 88.5 28, 92.5 31.5, 95.5 33.5 C 97 34.5, 98.5 33.5, 100.5 31" />

    <!-- WORD 2: "you" -->
    <!-- y: 11. Initial slant cup -->
    <path class="hw-stroke" data-order="11" data-speed="0.9" d="M 108.5 23 C 110.5 26, 113 29, 114.5 31 C 116.5 28, 119 24, 121.5 21.5" />
    <!-- y: 12. Long descender loop swinging up -->
    <path class="hw-stroke" data-order="12" data-speed="1.3" d="M 121 22 C 119.5 29, 117 38, 115 44 C 113.5 49, 110 50.5, 107.5 47.5 C 105.5 44.5, 110.5 38, 115.5 32 C 118.5 28, 122.5 26, 125.5 27" />
    <!-- o: 13. Loose oval loop with top tie -->
    <path class="hw-stroke" data-order="13" data-speed="1.1" d="M 133.5 23 C 128.5 21.5, 124.5 25.5, 126 30.5 C 127.5 34.5, 133.5 34, 135 28 C 136 24.5, 133.5 22.5, 131.5 23 C 134.5 23.5, 137.5 25, 139.5 27" />
    <!-- u: 14. First downcurve cup -->
    <path class="hw-stroke" data-order="14" data-speed="0.9" d="M 142.5 23 C 143 27, 142.5 31, 146.5 32 C 149.5 32.5, 151.5 28, 152.5 23" />
    <!-- u: 15. Right stem and exit ligature -->
    <path class="hw-stroke" data-order="15" data-speed="0.9" d="M 152.5 23 C 152.5 27, 152 31, 153.5 32.5 C 155.5 34, 158.5 32, 161.5 29" />

    <!-- WORD 3: "for" -->
    <!-- f: 16. Tall looped ascender dropping down to descender -->
    <path class="hw-stroke" data-order="16" data-speed="1.4" d="M 167.5 30 C 170.5 26, 174.5 13, 176.5 8 C 178 5, 175.5 9, 173.5 19 C 171 31, 167.5 45, 165.5 48 C 164 50, 167.5 42, 171.5 32 C 174.5 25.5, 178.5 24, 181.5 26" />
    <!-- f: 17. Quick crossbar tick -->
    <path class="hw-stroke" data-order="17" data-speed="0.7" d="M 166.5 22 C 170.5 21.5, 174.5 21, 177.5 20.5" />
    <!-- o: 18. Quick oval -->
    <path class="hw-stroke" data-order="18" data-speed="1.0" d="M 188.5 23 C 184 21.5, 180 25.5, 181.5 30.5 C 183 34.5, 189 34, 190.5 28.5 C 191.5 24.5, 188.5 22.5, 186 23 C 189 23.5, 192.5 25.5, 194.5 27" />
    <!-- r: 19. Stem, shoulder and downward leg -->
    <path class="hw-stroke" data-order="19" data-speed="1.0" d="M 197.5 23 C 198 26.5, 197.5 30.5, 197.8 33 C 198 28, 199.5 23, 203 22.5 C 205.5 22, 207 23.5, 208.5 25.5 C 210 27.5, 211.5 32, 213.5 31" />

    <!-- WORD 4: "stopping" -->
    <!-- s: 20. S curve stroke -->
    <path class="hw-stroke" data-order="20" data-speed="1.1" d="M 222.5 23 C 219.5 21.5, 215 22, 215.5 25.5 C 216 28, 221.5 28, 222 31 C 222.5 34, 217.5 35, 215 33.5" />
    <!-- t: 21. Downward stem with curve -->
    <path class="hw-stroke" data-order="21" data-speed="1.0" d="M 227.5 13 C 228 20, 227 28, 227.5 32 C 228 33.5, 230 34, 232.5 32" />
    <!-- o: 22. Oval loop -->
    <path class="hw-stroke" data-order="22" data-speed="1.0" d="M 240.5 23 C 236.5 21.5, 232.5 25.5, 234 30.5 C 235.5 34.5, 241 34, 242.5 28.5 C 243.5 24.5, 240.5 22.5, 238 23 C 241 24, 243.5 26, 245.5 28" />
    <!-- p1: 23. First p downstem into descender -->
    <path class="hw-stroke" data-order="23" data-speed="1.1" d="M 248.5 23 C 249 29, 247.5 37, 246.5 43" />
    <!-- p1: 24. First p bowl -->
    <path class="hw-stroke" data-order="24" data-speed="0.9" d="M 247.5 24 C 251 21.5, 256 22.5, 256.3 27 C 256.5 31.5, 251.5 33, 248 32.5 C 250 32, 252.5 30, 254.5 28" />
    <!-- p2: 25. Second p downstem into descender -->
    <path class="hw-stroke" data-order="25" data-speed="1.1" d="M 258.5 23 C 259 29, 257.5 37, 256.5 43" />
    <!-- p2: 26. Second p bowl -->
    <path class="hw-stroke" data-order="26" data-speed="0.9" d="M 257.5 24 C 261 21.5, 266 22.5, 266.3 27 C 266.5 31.5, 261.5 33, 258 32.5 C 260 32, 263.5 29, 266.5 27" />
    <!-- i: 27. Short stem with exit flick -->
    <path class="hw-stroke" data-order="27" data-speed="0.8" d="M 270.5 23 C 271 26.5, 270.5 30, 271 32.5 C 271.5 34, 273.5 33, 275.5 30" />
    <!-- n: 28. Left downstroke -->
    <path class="hw-stroke" data-order="28" data-speed="0.8" d="M 278.5 23.5 C 279 27, 278.5 30.5, 278.7 33" />
    <!-- n: 29. Arch and downstroke with flick -->
    <path class="hw-stroke" data-order="29" data-speed="1.0" d="M 279 25 C 281.5 21.5, 285 21, 286 25.5 C 287 29, 287.5 32, 289.5 33 C 291 34, 292.5 32, 294.5 29" />
    <!-- g: 30. Round bowl -->
    <path class="hw-stroke" data-order="30" data-speed="1.0" d="M 303.5 23 C 299.5 21.5, 295 25, 296 29.5 C 297 33.5, 302 33.5, 303.5 28" />
    <!-- g: 31. Descender loop sweeping up -->
    <path class="hw-stroke" data-order="31" data-speed="1.3" d="M 303.5 23 C 304 28, 303 36, 301 42 C 299 47, 295 49, 292.5 46 C 290.5 43, 296.5 37, 302.5 32 C 306.5 28.5, 311.5 27, 314.5 29" />
    <!-- t crossbar (drawn after the word body is finished) -->
    <path class="hw-stroke" data-order="32" data-speed="0.6" d="M 222.5 18.5 C 226.5 18, 230.5 17.5, 234.5 17" />
    <!-- i dot (tapped after the word body is finished) -->
    <path class="hw-stroke" data-order="33" data-speed="0.4" d="M 271 15.5 C 271.3 15, 271.7 15.5, 271.4 16" />

    <!-- WORD 5: "by." -->
    <!-- b: 34. Tall ascender downstroke -->
    <path class="hw-stroke" data-order="34" data-speed="1.1" d="M 323.5 8 C 324 16, 322.5 26, 323 33" />
    <!-- b: 35. Belly loop -->
    <path class="hw-stroke" data-order="35" data-speed="0.9" d="M 323.5 26 C 326 22, 331.5 21.5, 332.5 26.5 C 333.5 31, 328.5 33.5, 324 32.5 C 326.5 32, 329.5 29, 332.5 27" />
    <!-- y: 36. Slant cup -->
    <path class="hw-stroke" data-order="36" data-speed="0.9" d="M 337.5 23 C 339.5 26, 342 29, 343.5 31 C 345.5 28, 348 24, 350.5 21.5" />
    <!-- y: 37. Descender loop with flick -->
    <path class="hw-stroke" data-order="37" data-speed="1.2" d="M 350 22 C 348.5 29, 346 38, 344 44 C 342.5 48.5, 339 50, 336.5 47 C 334.5 44, 339.5 38, 345.5 32.5 C 349.5 28.5, 353.5 27.5, 357.5 29.5" />
    <!-- Period "." (pen tap) -->
    <path class="hw-stroke" data-order="38" data-speed="0.4" d="M 363.5 30 C 363.8 29.5, 364.3 30, 363.9 30.5" />

    <!-- ==================== LARGER SLANTED SMILEY FACE: ":)" ==================== -->
    <!-- Eye 1: Top eye dot/flick -->
    <path class="hw-stroke" data-order="39" data-speed="0.5" d="M 374 15.5 C 374.4 14.5, 375.2 15, 374.7 16" />
    <!-- Eye 2: Bottom eye dot/flick -->
    <path class="hw-stroke" data-order="40" data-speed="0.5" d="M 374 23.5 C 374.4 22.5, 375.2 23, 374.7 24" />
    <!-- Smile: Prominent, larger, slanted curved parenthesis arc -->
    <path class="hw-stroke" data-order="41" data-speed="1.1" d="M 380 11.5 C 388 17, 388.5 31, 381 37.5" />
  </svg>
</div>

<style>
  .handwriting-wrapper {
    display: inline-block;
    width: 100%;
    max-width: 375px;
    cursor: pointer;
    margin-top: 0.25rem;
  }

  .handwriting-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .hw-stroke {
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0;
  }

  @media (max-width: 480px) {
    .handwriting-wrapper {
      max-width: 335px;
    }
    .hw-stroke {
      stroke-width: 1.5;
    }
  }
</style>

<script>
  function setupHandwritingAnimation() {
    const svg = document.getElementById("hw-svg");
    const container = document.getElementById("hw-signoff-wrapper");
    if (!svg || !container) return;

    const strokes = Array.from(svg.querySelectorAll<SVGPathElement>(".hw-stroke"));
    
    // Sort strokes strictly by data-order
    strokes.sort((a, b) => {
      const orderA = parseInt(a.getAttribute("data-order") || "0", 10);
      const orderB = parseInt(b.getAttribute("data-order") || "0", 10);
      return orderA - orderB;
    });

    // Compute stroke lengths and prepare dash offsets
    const strokeData = strokes.map((path) => {
      const length = path.getTotalLength() || 12;
      const speedMultiplier = parseFloat(path.getAttribute("data-speed") || "1.0");
      path.style.strokeDasharray = `${length} ${length + 3}`;
      path.style.strokeDashoffset = `${length}`;
      path.style.opacity = "0";
      return { path, length, speedMultiplier };
    });

    let isAnimating = false;

    async function playWriting() {
      if (isAnimating) return;
      isAnimating = true;

      // Reset all strokes instantly
      strokeData.forEach(({ path, length }) => {
        path.style.transition = "none";
        path.style.strokeDashoffset = `${length}`;
        path.style.opacity = "0";
      });

      // Allow DOM to apply resets
      await new Promise((r) => requestAnimationFrame(r));

      // Ultra-realistic human writing pace with human rhythm and pauses
      for (let i = 0; i < strokeData.length; i++) {
        const { path, length, speedMultiplier } = strokeData[i];
        const isDotOrTap = length < 8;
        const isSmileyArc = i === 40; // The larger slanted smile arc
        
        // Human pen speed calculation
        let baseDuration: number;
        if (isDotOrTap) {
          baseDuration = 100;
        } else if (isSmileyArc) {
          baseDuration = Math.max(160, Math.min(length * 5.8 * speedMultiplier, 400));
        } else {
          baseDuration = Math.max(130, Math.min(length * 5.2 * speedMultiplier, 420));
        }

        path.style.opacity = "1";
        // Human easing: gradual acceleration with gentle deceleration
        path.style.transition = `stroke-dashoffset ${baseDuration}ms cubic-bezier(0.42, 0, 0.25, 1)`;
        path.style.strokeDashoffset = "0";

        // Natural pen-lift pause before next stroke
        let pause: number;
        if (isDotOrTap) {
          pause = 75;
        } else if (i === 37) {
          // Pause after period before starting slanted smiley
          pause = 180;
        } else if (i === 39) {
          // Micro pause after eyes before drawing smile arc
          pause = 100;
        } else if (i === 31 || i === 32) {
          // Micro pause before crossing t or dotting i
          pause = 90;
        } else {
          pause = Math.max(35, baseDuration * 0.76);
        }

        await new Promise((r) => setTimeout(r, pause));
      }

      isAnimating = false;
    }

    // Trigger on viewport entrance
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            playWriting();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(container);

    // Replay on click
    container.addEventListener("click", () => {
      playWriting();
    });
  }

  document.addEventListener("astro:page-load", setupHandwritingAnimation);
  setupHandwritingAnimation();
</script>
