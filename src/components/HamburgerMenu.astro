---
// Full-page menu overlay with instant static icon swap (zero morphing animation)
---

<!-- Single top-right button for open and close -->
<button
  id="hamburger-btn"
  class="hamburger-btn"
  aria-label="Toggle menu"
  aria-expanded="false"
>
  <!-- Minimal 2-line icon when menu is closed -->
  <svg class="icon-menu" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <line x1="1" y1="5" x2="15" y2="5" />
    <line x1="1" y1="11" x2="15" y2="11" />
  </svg>
  <!-- Crisp X icon when menu is open -->
  <svg class="icon-close" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <line x1="3" y1="3" x2="13" y2="13" />
    <line x1="13" y1="3" x2="3" y2="13" />
  </svg>
</button>

<style>
  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -13px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: inherit;
    position: relative;
    z-index: 10001;
    outline: none !important;
    -webkit-tap-highlight-color: transparent !important;
    transition: opacity 120ms ease-out;
  }

  .hamburger-btn:active {
    opacity: 0.6;
  }

  .icon-menu {
    display: block;
  }

  .icon-close {
    display: none;
  }

  /* Instant static icon swap (zero rotation, zero morphing animation) */
  .hamburger-btn[aria-expanded="true"] .icon-menu {
    display: none;
  }

  .hamburger-btn[aria-expanded="true"] .icon-close {
    display: block;
  }
</style>

<script>
  let currentToggleHandler: ((e: Event) => void) | null = null;

  function initHamburger() {
    if (currentToggleHandler) {
      document.removeEventListener(
        "toggle-hamburger-menu",
        currentToggleHandler,
      );
      currentToggleHandler = null;
    }

    const btn = document.getElementById(
      "hamburger-btn",
    ) as HTMLButtonElement | null;
    if (!btn) return;

    // Clean up any existing overlay to prevent duplicates
    const existingOverlay = document.getElementById("menu-overlay");
    if (existingOverlay) {
      existingOverlay.remove();
    }

    const overlay = document.createElement("div");
    overlay.id = "menu-overlay";
    overlay.setAttribute("aria-hidden", "true");
    overlay.innerHTML = `
      <div class="mo-inner">
        <nav class="mo-nav">
          <a href="/projects" class="mo-link" data-s="1">Projects</a>
          <a href="/writing" class="mo-link" data-s="2">Writing</a>
          <a href="/artifacts" class="mo-link" data-s="3">Artifacts</a>
          <a href="/other" class="mo-link" data-s="4">Other</a>
          <a href="https://www.cosmos.so/farooqqureshi" target="_blank" rel="noopener" class="mo-link" data-s="5">Cosmos</a>
          <a href="https://linkedin.com/in/farooqq" target="_blank" rel="noopener" class="mo-link" data-s="6">LinkedIn</a>
          <a href="https://github.com/farooqqureshii" target="_blank" rel="noopener" class="mo-link" data-s="7">GitHub</a>
          <a href="mailto:farooq.qureshi@outlook.com" class="mo-link" data-s="8">Email</a>
        </nav>
        <div class="mo-actions">
          <button id="menu-theme-toggle" class="mo-action-btn" data-s="9"><span id="menu-theme-label">Dark</span></button>
          <button id="menu-sound-toggle" class="mo-action-btn" style="margin-top: 0.5rem;" data-s="10"><span id="menu-sound-label">Sound: On</span></button>
        </div>
      </div>
    `;

    if (!document.getElementById("hamburger-menu-styles")) {
      const style = document.createElement("style");
      style.id = "hamburger-menu-styles";
      style.textContent = `
        #menu-overlay {
          position: fixed;
          inset: 0;
          z-index: 10000;
          background: #ffffff;
          color: #111111;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0;
          visibility: hidden;
          transition: opacity 160ms ease-out, visibility 0s linear 160ms;
        }
        html.dark #menu-overlay {
          background: #1a1a1a;
          color: #e4e4e7;
        }
        #menu-overlay.open {
          opacity: 1;
          visibility: visible;
          transition: opacity 160ms ease-out, visibility 0s linear 0s;
        }
        #menu-overlay.closing {
          opacity: 0;
          transition: opacity 140ms ease-out, visibility 0s linear 140ms;
        }

        .mo-inner {
          width: 100%;
          max-width: 600px;
          padding: 2.5rem 2rem;
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: 2rem;
        }
        .mo-nav {
          display: flex;
          flex-direction: column;
          gap: 0;
        }
        .mo-link {
          font-size: 2.25rem;
          font-weight: 400;
          letter-spacing: -0.03em;
          color: inherit;
          text-decoration: none;
          line-height: 1.35;
          position: relative;
        }
        .mo-link::after,
        .mo-action-btn::after {
          display: none !important;
        }

        .mo-actions {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: 0;
        }
        .mo-action-btn {
          background: transparent;
          border: none;
          cursor: pointer;
          color: inherit;
          font-size: 2.25rem;
          font-weight: 400;
          letter-spacing: -0.03em;
          font-family: inherit;
          padding: 0;
          line-height: 1.35;
          display: block;
          text-align: left;
          position: relative;
          -webkit-font-smoothing: antialiased;
        }
        #menu-theme-label,
        #menu-sound-label {
          display: inline-block;
          -webkit-transform: translateZ(0);
          transform: translateZ(0);
          font-weight: 400;
          color: inherit;
        }
      `;
      document.head.appendChild(style);
    }

    document.body.appendChild(overlay);

    function toggleTheme() {
      const html = document.documentElement;
      html.classList.add("theme-transition");
      const isDark = html.classList.contains("dark");
      if (isDark) {
        html.classList.remove("dark");
        localStorage.theme = "light";
      } else {
        html.classList.add("dark");
        localStorage.theme = "dark";
      }
      setTimeout(() => html.classList.remove("theme-transition"), 180);
      updateThemeLabel();
    }

    function updateThemeLabel() {
      const label = document.getElementById("menu-theme-label");
      if (!label) return;
      label.textContent = document.documentElement.classList.contains("dark")
        ? "Light"
        : "Dark";
    }

    function toggleSound() {
      const isMuted = localStorage.sound === "off";
      if (isMuted) {
        localStorage.sound = "on";
      } else {
        localStorage.sound = "off";
      }
      updateSoundLabel();
      window.dispatchEvent(new CustomEvent("sound-toggled"));
    }

    function updateSoundLabel() {
      const label = document.getElementById("menu-sound-label");
      if (!label) return;
      label.textContent =
        localStorage.sound === "off" ? "Sound: Off" : "Sound: On";
    }

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") closeMenu();
    };

    function openMenu() {
      updateThemeLabel();
      updateSoundLabel();

      const scrollBarComp =
        window.innerWidth - document.documentElement.clientWidth;
      if (scrollBarComp > 0)
        document.body.style.paddingRight = scrollBarComp + "px";
      document.body.style.overflow = "hidden";
      overlay.classList.remove("closing");
      overlay.classList.add("open");

      document.addEventListener("keydown", handleKeyDown);

      btn?.setAttribute("aria-expanded", "true");
      overlay.setAttribute("aria-hidden", "false");
    }

    function closeMenu() {
      if (!overlay.classList.contains("open")) return;

      overlay.classList.add("closing");
      overlay.classList.remove("open");
      btn?.setAttribute("aria-expanded", "false");
      overlay.setAttribute("aria-hidden", "true");

      document.removeEventListener("keydown", handleKeyDown);

      setTimeout(() => {
        overlay.classList.remove("closing");
        document.body.style.overflow = "";
        document.body.style.paddingRight = "";
      }, 140);
    }

    btn.addEventListener("click", () => {
      overlay.classList.contains("open") ? closeMenu() : openMenu();
    });

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeMenu();
    });

    overlay
      .querySelectorAll(".mo-link")
      .forEach((l) => l.addEventListener("click", closeMenu));

    overlay
      .querySelector("#menu-theme-toggle")
      ?.addEventListener("click", toggleTheme);

    overlay
      .querySelector("#menu-sound-toggle")
      ?.addEventListener("click", toggleSound);

    currentToggleHandler = (e: Event) => {
      const customEvent = e as CustomEvent<{
        action?: "open" | "close" | "toggle";
      }>;
      const action = customEvent.detail?.action;
      if (action === "open") {
        openMenu();
      } else if (action === "close") {
        closeMenu();
      } else {
        overlay.classList.contains("open") ? closeMenu() : openMenu();
      }
    };
    document.addEventListener("toggle-hamburger-menu", currentToggleHandler);
  }

  document.addEventListener("astro:page-load", initHamburger);
</script>
