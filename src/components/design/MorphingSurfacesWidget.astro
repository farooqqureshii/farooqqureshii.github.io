---
// MorphingSurfacesWidget.astro
// Design Engineering Experiment: Non-Distorting Morphing Surfaces & Clip-Path Geometry
interface Props {
  compact?: boolean;
  showControls?: boolean;
}

const { compact = false, showControls = true } = Astro.props;
---

<div
  class={`morphing-surfaces-widget relative w-full ${
    compact
      ? "aspect-[4/3] max-h-80 p-4 flex flex-col justify-between"
      : "p-6 sm:p-8"
  } bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800/80 rounded-2xl overflow-hidden select-none font-sans text-zinc-900 dark:text-zinc-100 transition-colors duration-150`}
>
  <!-- Header & Mode Selector -->
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
      <span class="text-xs font-mono tracking-tight text-zinc-600 dark:text-zinc-400">
        Morphing Surfaces Lab
      </span>
    </div>

    <!-- Mode Switcher -->
    <div class="mode-toggle flex items-center p-0.5 bg-zinc-200/80 dark:bg-zinc-800/80 border border-zinc-300/60 dark:border-zinc-700/60 rounded-lg text-[11px]">
      <button
        type="button"
        class="mode-btn mode-scale px-2 py-1 rounded-md text-zinc-600 dark:text-zinc-400 transition-colors font-medium cursor-pointer"
        data-mode="scale"
      >
        Scale Transform
      </button>
      <button
        type="button"
        class="mode-btn mode-layout px-2 py-1 rounded-md text-zinc-600 dark:text-zinc-400 transition-colors font-medium cursor-pointer"
        data-mode="layout"
      >
        Layout Reflow
      </button>
      <button
        type="button"
        class="mode-btn mode-clippath active px-2.5 py-1 rounded-md bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 shadow-sm border border-zinc-200 dark:border-zinc-700/80 font-medium transition-all cursor-pointer"
        data-mode="clippath"
      >
        Clip-Path Inset
      </button>
    </div>
  </div>

  <!-- Interactive Stage Container -->
  <div
    class={`stage-area relative w-full ${
      compact ? "h-44" : "h-64 sm:h-72"
    } bg-white dark:bg-zinc-950 border border-zinc-200/80 dark:border-zinc-800/80 rounded-xl overflow-hidden flex flex-col items-center justify-center p-4 sm:p-6 gap-6`}
  >
    <!-- Segmented Navigation Bar -->
    <div class="segmented-wrapper relative w-full max-w-sm bg-zinc-100 dark:bg-zinc-900/90 border border-zinc-200 dark:border-zinc-800 rounded-xl p-1 flex items-center justify-between">
      <!-- Active Pill Indicator Background -->
      <div
        class="active-indicator absolute bg-zinc-900 dark:bg-zinc-100 rounded-lg pointer-events-none transition-all"
        style="left: 4px; top: 4px; width: 110px; height: 36px;"
      ></div>

      <!-- Clip-Path Exact Foreground Overlay for Crisp Text Color Swap -->
      <div
        class="clippath-overlay absolute inset-1 bg-zinc-900 dark:bg-zinc-100 rounded-lg pointer-events-none flex items-center justify-between px-3 text-white dark:text-zinc-950 text-xs font-medium z-10 opacity-0"
        style="clip-path: inset(0 66% 0 0);"
      >
        <span class="w-1/3 text-center">Overview</span>
        <span class="w-1/3 text-center">Telemetry</span>
        <span class="w-1/3 text-center">Settings</span>
      </div>

      <!-- Tab Buttons Base -->
      <div class="relative z-0 grid grid-cols-3 w-full text-center text-xs font-medium">
        <button type="button" class="tab-btn px-3 py-2 rounded-lg text-white dark:text-zinc-950 transition-colors cursor-pointer" data-tab-idx="0">
          Overview
        </button>
        <button type="button" class="tab-btn px-3 py-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors cursor-pointer" data-tab-idx="1">
          Telemetry
        </button>
        <button type="button" class="tab-btn px-3 py-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors cursor-pointer" data-tab-idx="2">
          Settings
        </button>
      </div>
    </div>

    <!-- Active Content Panel -->
    <div class="content-panel w-full max-w-sm bg-zinc-50 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 rounded-xl p-3 text-xs text-zinc-600 dark:text-zinc-400 flex items-center justify-between">
      <span class="panel-text">Tab 0: Overview & Physical Principles</span>
      <span class="distortion-badge font-mono text-[10px] px-2 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
        No Distortion
      </span>
    </div>
  </div>

  <!-- Telemetry Bar & Controls -->
  {
    showControls && (
      <div class="mt-4 pt-3 border-t border-zinc-200 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <div class="flex items-center gap-4">
          <div>
            Active Method: <span class="readout-method font-semibold text-zinc-900 dark:text-zinc-100">Clip-Path Inset</span>
          </div>
          <div>
            Reflows: <span class="readout-reflows font-semibold text-emerald-500">0 (GPU Only)</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span>Playback Speed:</span>
          <button
            type="button"
            class="speed-btn px-2 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 cursor-pointer text-[11px]"
            data-speed="1"
          >
            100%
          </button>
          <button
            type="button"
            class="speed-btn px-2 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800/60 text-zinc-500 cursor-pointer text-[11px]"
            data-speed="0.25"
          >
            25% Slow-Mo
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  function initMorphingSurfaces() {
    const widgets = document.querySelectorAll(".morphing-surfaces-widget");

    widgets.forEach((widget) => {
      const tabs = widget.querySelectorAll(".tab-btn");
      const indicator = widget.querySelector(".active-indicator") as HTMLElement;
      const clippathOverlay = widget.querySelector(".clippath-overlay") as HTMLElement;
      const modeBtns = widget.querySelectorAll(".mode-btn");
      const speedBtns = widget.querySelectorAll(".speed-btn");
      const panelText = widget.querySelector(".panel-text");
      const distortionBadge = widget.querySelector(".distortion-badge");
      const readoutMethod = widget.querySelector(".readout-method");
      const readoutReflows = widget.querySelector(".readout-reflows");

      if (!indicator || tabs.length === 0) return;

      let mode: "scale" | "layout" | "clippath" = "clippath";
      let playbackSpeed = 1;
      let activeIdx = 0;
      let reflowCount = 0;

      const panelContents = [
        "Tab 0: Overview & Physical Principles",
        "Tab 1: Real-time Telemetry & GPU Layering",
        "Tab 2: Elastic Curves & Clip-Path Geometry"
      ];

      // Mode Switcher Handler
      modeBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          modeBtns.forEach((b) => b.classList.remove("active", "bg-white", "dark:bg-zinc-900", "shadow-sm", "text-zinc-900", "dark:text-zinc-100"));
          modeBtns.forEach((b) => b.classList.add("text-zinc-600", "dark:text-zinc-400"));
          btn.classList.add("active", "bg-white", "dark:bg-zinc-900", "shadow-sm", "text-zinc-900", "dark:text-zinc-100");
          btn.classList.remove("text-zinc-600", "dark:text-zinc-400");
          
          mode = (btn as HTMLElement).dataset.mode as "scale" | "layout" | "clippath";
          updateTabState(activeIdx);
        });
      });

      // Speed Switcher Handler
      speedBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          speedBtns.forEach((b) => b.classList.remove("bg-zinc-200", "dark:bg-zinc-800", "text-zinc-800", "dark:text-zinc-200"));
          speedBtns.forEach((b) => b.classList.add("bg-zinc-200/60", "dark:bg-zinc-800/60", "text-zinc-500"));
          btn.classList.add("bg-zinc-200", "dark:bg-zinc-800", "text-zinc-800", "dark:text-zinc-200");
          btn.classList.remove("bg-zinc-200/60", "dark:bg-zinc-800/60", "text-zinc-500");

          playbackSpeed = parseFloat((btn as HTMLElement).dataset.speed || "1");
          updateTabState(activeIdx);
        });
      });

      function updateTabState(targetIdx: number) {
        activeIdx = targetIdx;
        const duration = Math.round(240 / playbackSpeed);
        const easing = "cubic-bezier(0.23, 1, 0.32, 1)";

        if (panelText) panelText.textContent = panelContents[targetIdx];

        // Reset base tab styles
        tabs.forEach((tab, i) => {
          if (i === targetIdx) {
            tab.className = "tab-btn px-3 py-2 rounded-lg text-white dark:text-zinc-950 transition-colors cursor-pointer";
          } else {
            tab.className = "tab-btn px-3 py-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors cursor-pointer";
          }
        });

        if (mode === "scale") {
          // Naive Scale Transform mode: scaleX distorts text aspect ratio and border radius
          if (clippathOverlay) clippathOverlay.style.opacity = "0";
          
          const xOffset = targetIdx * 116;
          indicator.style.transition = `transform ${duration}ms ${easing}`;
          indicator.style.transform = `translateX(${xOffset}px) scaleX(1.15)`;
          
          if (distortionBadge) {
            distortionBadge.textContent = "Border & Text Warped!";
            distortionBadge.className = "distortion-badge font-mono text-[10px] px-2 py-0.5 rounded bg-amber-500/20 text-amber-600 dark:text-amber-400";
          }
          if (readoutMethod) readoutMethod.textContent = "Naive scaleX()";
          if (readoutReflows) readoutReflows.textContent = "0 (Visual Warp)";

          setTimeout(() => {
            indicator.style.transform = `translateX(${xOffset}px) scaleX(1)`;
          }, duration * 0.4);

        } else if (mode === "layout") {
          // Layout Reflow mode: left/width animation causes reflows
          if (clippathOverlay) clippathOverlay.style.opacity = "0";
          
          reflowCount += 1;
          const leftPos = 4 + targetIdx * 116;
          indicator.style.transform = "none";
          indicator.style.transition = `left ${duration}ms ${easing}, width ${duration}ms ${easing}`;
          indicator.style.left = `${leftPos}px`;
          indicator.style.width = "110px";

          if (distortionBadge) {
            distortionBadge.textContent = "Layout Reflow!";
            distortionBadge.className = "distortion-badge font-mono text-[10px] px-2 py-0.5 rounded bg-red-500/20 text-red-600 dark:text-red-400";
          }
          if (readoutMethod) readoutMethod.textContent = "Layout left/width";
          if (readoutReflows) {
            readoutReflows.textContent = `${reflowCount} reflows (DOM repaint)`;
            readoutReflows.className = "readout-reflows font-semibold text-red-500";
          }

        } else {
          // Engineered Clip-Path Inset mode: hardware accelerated, 60fps, zero distortion
          const leftPct = targetIdx * 33.33;
          const rightPct = 100 - (targetIdx + 1) * 33.33;

          const xOffset = targetIdx * 116;
          indicator.style.transition = `transform ${duration}ms ${easing}`;
          indicator.style.transform = `translateX(${xOffset}px)`;
          indicator.style.left = "4px";

          if (clippathOverlay) {
            clippathOverlay.style.opacity = "1";
            clippathOverlay.style.transition = `clip-path ${duration}ms ${easing}`;
            clippathOverlay.style.clipPath = `inset(0 ${rightPct}% 0 ${leftPct}%)`;
          }

          if (distortionBadge) {
            distortionBadge.textContent = "Zero Distortion";
            distortionBadge.className = "distortion-badge font-mono text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400";
          }
          if (readoutMethod) readoutMethod.textContent = "Clip-Path Inset";
          if (readoutReflows) {
            readoutReflows.textContent = "0 (GPU Layer)";
            readoutReflows.className = "readout-reflows font-semibold text-emerald-500";
          }
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const idx = parseInt((tab as HTMLElement).dataset.tabIdx || "0");
          updateTabState(idx);
        });
      });

      // Initial state
      updateTabState(0);
    });
  }

  // Initialize on page load and Astro view transitions
  initMorphingSurfaces();
  document.addEventListener("astro:after-swap", initMorphingSurfaces);
</script>
